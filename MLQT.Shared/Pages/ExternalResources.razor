<MudPaper Elevation="1" Height="calc(100vh - 135px)" Class="pt-2" Style="overflow-y: auto;">
    @if (NavState.IsDeferredMode && !NavState.HasExternalResourcesAnalyzed && _allResources.Count == 0)
    {
        <MudStack Row="false" AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height: 100%;">
            <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Large" Color="Color.Default" />
            <MudText Typo="Typo.subtitle1">External resource analysis has not been run yet</MudText>
            <MudText Typo="Typo.body1">
                External resource analysis was deferred because the repository exceeds the model count threshold.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       OnClick="RunExternalResourceAnalysisAsync" Disabled="_isRunningAnalysis">
                @if (_isRunningAnalysis)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                    <MudText>Running...</MudText>
                }
                else
                {
                    <MudText>Run External Resource Analysis Now</MudText>
                }
            </MudButton>
        </MudStack>
    }
    else if (_allResources.Count == 0)
    {
        <MudText Typo="Typo.subtitle1">No external resources detected</MudText>
        <MudText Typo="Typo.body1">
            Load a library to analyze resource references.
        </MudText>
    }
    else
    {
        <MudStack Row="false" Style="gap:4px !important;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Style="gap:8px;" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.subtitle2">Filter by type:</MudText>
                <MudChipSet T="string" SelectionMode="SelectionMode.MultiSelection" SelectedValues="_selectedFileTypes" SelectedValuesChanged="OnFileTypeFilterChanged" CheckMark="true">
                    <MudTooltip Text="@string.Join(',',DataExtensions)" Arrow="true" Placement="Placement.Bottom">
                        <MudChip T="string" Value="@("data")" Size="Size.Small" Default="true">Data Files</MudChip>
                    </MudTooltip>
                    <MudTooltip Text="@string.Join(',',CCodeExtensions)" Arrow="true" Placement="Placement.Bottom">
                        <MudChip T="string" Value="@("ccode")" Size="Size.Small" Default="true">C/C++</MudChip>
                    </MudTooltip>
                    <MudTooltip Text="@string.Join(',',LibExtensions)" Arrow="true" Placement="Placement.Bottom">
                        <MudChip T="string" Value="@("lib")" Size="Size.Small" Default="true">Libs</MudChip>
                    </MudTooltip>
                    <MudTooltip Text="@string.Join(',',ImageExtensions)" Arrow="true" Placement="Placement.Bottom">
                        <MudChip T="string" Value="@("images")" Size="Size.Small">Images</MudChip>
                    </MudTooltip>
                    <MudTooltip Text="@string.Join(',',DocumentExtensions)" Arrow="true" Placement="Placement.Bottom">
                        <MudChip T="string" Value="@("documents")" Size="Size.Small" Default="false">Documentation</MudChip>
                    </MudTooltip>
                    <MudTooltip Text="All file types" Arrow="true" Placement="Placement.Bottom">
                        <MudChip T="string" Value="@("other")" Size="Size.Small" Default="false">All</MudChip>
                    </MudTooltip>
                </MudChipSet>
                <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
                <MudText Typo="Typo.subtitle2">Warnings:</MudText>
                <MudChipSet T="string" SelectionMode="SelectionMode.MultiSelection" SelectedValues="_selectedWarningTypes" SelectedValuesChanged="OnWarningFilterChanged" CheckMark="true">
                    <MudTooltip Text="Show only resources where the file or directory is missing" Arrow="true" Placement="Placement.Bottom">
                        <MudChip T="string" Value="@("missing")" Size="Size.Small" IconColor="Color.Error" Icon="@Icons.Material.Filled.BrokenImage">Missing (@_missingCount)</MudChip>
                    </MudTooltip>
                    <MudTooltip Text="Show only resources using non-portable absolute paths" Arrow="true" Placement="Placement.Bottom">
                        <MudChip T="string" Value="@("absolute")" Size="Size.Small" IconColor="Color.Warning" Icon="@Icons.Material.Filled.Warning">Absolute Paths (@_absolutePathCount)</MudChip>
                    </MudTooltip>
                </MudChipSet>
            </MudStack>

            <MudGrid Spacing="1">
                <MudItem xs="4">
                    <MudPaper Elevation="0" Outlined="true" Style="height: calc(100vh - 210px); overflow-y: auto;">
                        <MudTreeView T="ResourceTreeNode"
                            @key="_treeKey"
                            @ref="_treeView"
                            Items="@_topLevelItems"
                            ServerData="@LoadServerData"
                            Dense="true"
                            Color="Color.Primary"
                            SelectedValueChanged="@((ResourceTreeNode node) => OnResourceSelected(node))">
                            <ItemTemplate>
                                <MudTreeViewItem Value="@context.Value"
                                    Items="@context.Children"
                                    ItemsChanged="@(new Action<IReadOnlyCollection<ITreeItemData<ResourceTreeNode>>>(items => OnNodeChildrenLoaded(context, items)))"
                                    Text="@GetNodeText(context.Value)"
                                    @bind-Expanded="@context.Expanded"
                                    CanExpand="@context.Expandable"
                                    Icon="@GetNodeIcon(context.Value)"
                                    IconColor="@GetNodeIconColor(context.Value)"
                                    ExpandButtonIcon="@Icons.Material.Filled.KeyboardArrowRight"
                                    LoadingIconColor="Color.Primary" />
                            </ItemTemplate>
                        </MudTreeView>
                    </MudPaper>
                </MudItem>
                <MudItem xs="8">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-2" Style="height: calc(100vh - 210px); overflow-y: auto;">
                        @if (_selectedResource == null)
                        {
                            <MudText Typo="Typo.body1" Color="Color.Secondary">Select a resource to see which models reference it.</MudText>
                        }
                        else
                        {
                            <MudStack Row="false" Style="gap:4px;">
                                <MudText Typo="Typo.subtitle2">@_selectedResource.Name</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@_selectedResource.FullPath</MudText>
                                @if (_selectedResource.IsDirectory && _selectedResource.AnnotationType != DirectoryAnnotationType.None)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="@GetAnnotationChipColor(_selectedResource.AnnotationType)">
                                        @GetAnnotationTypeLabel(_selectedResource.AnnotationType)
                                    </MudChip>
                                }
                                @if (_selectedResource.HasWarning)
                                {
                                    <MudAlert Severity="Severity.Warning" Dense="true" Class="my-1"><MudText>@_selectedResource.WarningMessage</MudText></MudAlert>
                                }

                                @if (_referencingModels.Count == 0)
                                {
                                    <MudText Typo="Typo.body2">No models reference this @(_selectedResource.IsDirectory ? "directory" : "resource").</MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.subtitle2" Class="mt-2">Referenced by @_referencingModels.Count model(s):</MudText>
                                    <MudTable T="ExternalResourceReference" Items="@_referencingModels" OnRowClick="OnModelClicked"
                                        Hover="true" Dense="true">
                                        <HeaderContent>
                                            <MudTh>Model</MudTh>
                                            <MudTh>Reference Type</MudTh>
                                        </HeaderContent>
                                        <RowTemplate>
                                            <MudTd DataLabel="Model" Class="compact-table">@context.ModelId</MudTd>
                                            <MudTd DataLabel="Reference Type" Class="compact-table">@context.ReferenceType</MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                }
                            </MudStack>
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudStack>
    }
</MudPaper>
