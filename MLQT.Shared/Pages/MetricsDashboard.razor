@using ModelicaGraph.Analysis
@using ModelicaGraph.DataTypes
@using MLQT.Services.Helpers
@using MudBlazor
@implements IDisposable
@inject ILibraryDataService LibraryDataService
@inject IRepositoryService RepositoryService
@inject AppState NavState
@inject ISnackbar Snackbar

<MudPaper Elevation="0" Class="pa-2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
        <MudText Typo="Typo.body1">Metrics</MudText>
        <MudAutocomplete T="string" Value="_scope" ValueChanged="OnScopeChanged" SearchFunc="SearchScopes"
                         Placeholder="All libraries" Label="Scope (package)" Dense="true" Margin="Margin.Dense"
                         Clearable="true" ResetValueOnEmptyText="true" Class="ml-4" Style="max-width:320px;"
                         Typo="Typo.body1" />
        <MudSpacer />
        @if (_metrics is not null)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="mr-2"
                       OnClick="SaveSnapshot" Disabled="_loading" StartIcon="@Icons.Material.Filled.Timeline">
                Save snapshot
            </MudButton>
        }
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="mr-2"
                   OnClick="ComputeSummary" Disabled="_loading" StartIcon="@Icons.Material.Filled.TableChart">
            Compare sub-libraries
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                   OnClick="Compute" Disabled="_loading" StartIcon="@Icons.Material.Filled.Refresh">
            @(_metrics is null ? "Compute" : "Refresh")
        </MudButton>
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-3" />
        <MudText Typo="Typo.body2">Analysing @(_modelCount) classes…</MudText>
    }
    else if (_metrics is null)
    {
        <MudText Typo="Typo.body1" Class="mt-3">
            @(LibraryDataService.GetAllModels().Any()
                ? "Click Compute to calculate metrics for the loaded libraries."
                : "Load a library to see metrics.")
        </MudText>
    }
    else
    {
        <MudGrid Spacing="2" Class="mt-1">
            <MudItem xs="12" md="7">
                <MudText Typo="Typo.body1" Class="mb-1">
                    Coverage — <b>@(string.IsNullOrEmpty(_scope) ? "all libraries" : _scope)</b>
                </MudText>
                @foreach (var c in _metrics.Coverage)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0" Class="mb-1">
                        <MudText Typo="Typo.body2" Style="width:150px;">@c.Dimension</MudText>
                        <MudProgressLinear Color="@CoverageColor(c.Percent)" Value="@c.Percent" Rounded="true"
                                           Class="flex-grow-1 mx-2" Style="height:14px;" />
                        <MudText Typo="Typo.body2" Style="width:120px; text-align:right;">
                            @($"{c.Percent:0.#}%") <span style="opacity:0.6;">(@c.Compliant/@c.Eligible)</span>
                        </MudText>
                    </MudStack>
                }
                <MudText Typo="Typo.caption" Class="mt-1">
                    True source state — in-source waivers do not raise it. <b>Icon</b> counts a class's own
                    <code>Icon</code> graphics or one inherited via <code>extends</code>. <b>Unit</b> counts
                    every Real-derived variable (plain <code>Real</code> and SI/quantity types) as united
                    when its type fixes a unit or it declares one inline.
                </MudText>
            </MudItem>

            <MudItem xs="12" md="5">
                <MudText Typo="Typo.body1" Class="mb-1">Size</MudText>
                <MudSimpleTable Dense="true" Bordered="false" Striped="true" Elevation="0">
                    <tbody>
                        <tr><td>Classes</td><td style="text-align:right;">@_metrics.TotalClasses</td></tr>
                        <tr><td>Components</td><td style="text-align:right;">@_metrics.TotalComponents</td></tr>
                        @foreach (var kv in _metrics.ClassesByType.OrderByDescending(k => k.Value))
                        {
                            <tr>
                                <td style="padding-left:20px; opacity:0.75;">@kv.Key</td>
                                <td style="text-align:right; opacity:0.75;">@kv.Value</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudItem>
        </MudGrid>
    }

    @if (_summary.Count > 0)
    {
        <MudText Typo="Typo.body1" Class="mt-4 mb-1">
            Sub-library comparison — <b>@(string.IsNullOrEmpty(_scope) ? "loaded libraries" : _scope)</b>
        </MudText>
        <div style="overflow-x:auto;">
            <MudSimpleTable Dense="true" Hover="true" Bordered="false" Striped="true" Elevation="0">
                <thead>
                    <tr>
                        <th style="text-align:left;">Package</th>
                        <th style="text-align:right;">Classes</th>
                        @foreach (var d in _summaryDimensions)
                        {
                            <th style="text-align:right;">@d</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _summary)
                    {
                        <tr>
                            <td>
                                <MudLink Typo="Typo.body2" Style="cursor:pointer;"
                                         @onclick="@(() => OnScopeChanged(row.Package))">@ShortName(row.Package)</MudLink>
                            </td>
                            <td style="text-align:right;">@row.Metrics.TotalClasses</td>
                            @foreach (var c in row.Metrics.Coverage)
                            {
                                <td style="text-align:right;">
                                    <MudText Typo="Typo.body2" Inline="true" Color="@CoverageColor(c.Percent)">@($"{c.Percent:0}%")</MudText>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </div>
        <MudText Typo="Typo.caption">Click a package to focus the whole dashboard on it.</MudText>
    }

    @if (_scopedHistory.Count >= 2)
    {
        <MudText Typo="Typo.body1" Class="mt-4 mb-1">
            Coverage trend — <b>@(string.IsNullOrEmpty(_scope) ? "all libraries" : _scope)</b>
        </MudText>
        <div style="overflow-x:auto;">
            @* Built as a MarkupString: SVG <text> collides with Razor's reserved <text> tag. *@
            @((MarkupString)BuildTrendSvg())
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="flex-wrap mb-2">
                @foreach (var sv in TrendLegend())
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <span style="display:inline-block; width:12px; height:12px; border-radius:2px; background:@sv.Color;"></span>
                        <MudText Typo="Typo.caption">@sv.Dim</MudText>
                    </MudStack>
                }
            </MudStack>
        </div>
        <div style="overflow-x:auto;">
            <MudSimpleTable Dense="true" Bordered="false" Striped="true" Elevation="0">
                <thead>
                    <tr>
                        <th style="text-align:left;">Snapshot</th>
                        <th style="text-align:right;">Classes</th>
                        @foreach (var d in _dimensions)
                        {
                            <th style="text-align:right;">@d</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _scopedHistory.AsEnumerable().Reverse().Take(15))
                    {
                        <tr>
                            <td>@s.TimestampUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td style="text-align:right;">@s.TotalClasses</td>
                            @foreach (var d in _dimensions)
                            {
                                <td style="text-align:right;">@(s.Coverage.TryGetValue(d, out var v) ? $"{v:0.#}%" : "—")</td>
                            }
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </div>
        <MudText Typo="Typo.caption">Line chart shows coverage % over time; the table lists exact values (most recent first) for the selected scope. Snapshots are saved per library in each repository's version-controlled <code>.mlqt/metrics-history.json</code> — commit them so reviewers share the same burndown. The "all libraries" view aggregates the per-repository snapshots.</MudText>
    }
    else if (_metrics is not null)
    {
        <MudText Typo="Typo.caption" Class="mt-3">
            Save snapshots over time to build a coverage-burndown trend for this scope.
        </MudText>
    }
</MudPaper>

@code {
    private LibraryMetrics? _metrics;
    private bool _loading;
    private int _modelCount;
    private string _scope = "";   // "" = all loaded libraries; else a package id

    private List<MetricsSnapshot> _history = new();
    private List<MetricsSnapshot> _scopedHistory = new();
    private List<string> _dimensions = new();

    private List<(string Package, LibraryMetrics Metrics)> _summary = new();
    private List<string> _summaryDimensions = new();

    // Line colours for the coverage-trend chart, one per dimension. Chosen to read on light and dark.
    private static readonly string[] TrendPalette =
        { "#2196f3", "#4caf50", "#ff9800", "#e91e63", "#9c27b0", "#00bcd4" };

    protected override void OnInitialized()
    {
        NavState.OnLibraryCleared += OnLibraryCleared;
        LibraryDataService.OnLibrariesChanged += OnLibrariesChanged;
        _history = LoadAllHistory();
        RebuildTrend();
        base.OnInitialized();
    }

    // Reload the merged history when the set of loaded libraries/repositories changes, so a newly loaded
    // library's shared history appears without reopening the tab.
    private void OnLibrariesChanged()
    {
        _history = LoadAllHistory();
        RebuildTrend();
        InvokeAsync(StateHasChanged);
    }

    // Packages the user can scope to (matched against what they type). Capped so the list stays usable.
    private Task<IEnumerable<string>> SearchScopes(string value, System.Threading.CancellationToken token)
    {
        var packages = LibraryDataService.GetAllModels()
            .Where(m => m.ClassType == "package")
            .Select(m => m.Id);
        if (!string.IsNullOrWhiteSpace(value))
            packages = packages.Where(id => id.Contains(value, System.StringComparison.OrdinalIgnoreCase));
        return Task.FromResult<IEnumerable<string>>(
            packages.OrderBy(id => id, System.StringComparer.Ordinal).Take(50).ToList());
    }

    private async Task OnScopeChanged(string? scope)
    {
        _scope = scope ?? "";
        _summary = new();   // stale relative to the new scope; user re-runs Compare to break it down
        RebuildTrend();
        if (_metrics is not null)
            await Compute();      // re-measure for the new scope
        else
            StateHasChanged();
    }

    private async Task SaveSnapshot()
    {
        if (_metrics is null)
            return;

        var timestamp = System.DateTime.UtcNow;
        int sharedCount = 0;
        bool anyPerUser = false;

        try
        {
            if (!string.IsNullOrEmpty(_scope))
            {
                // A scope belongs to exactly one library — its repository's shared file, or the per-user
                // file for a library not loaded from a repository. _metrics already covers this scope.
                var repoLocalPath = OwningRepositoryLocalPath(_scope);
                var path = !string.IsNullOrEmpty(repoLocalPath)
                    ? MetricsHistoryStore.RepoPath(repoLocalPath)
                    : MetricsHistoryStore.DefaultPath;
                MetricsHistoryStore.Append(path, MetricsSnapshot.From(_metrics, _scope, timestamp));
                if (!string.IsNullOrEmpty(repoLocalPath)) sharedCount++; else anyPerUser = true;
            }
            else
            {
                // "All libraries": store a per-library snapshot in each repository's own shared file
                // (and one per-user file for any non-repo libraries), so each travels with its library
                // and RebuildTrend aggregates them on read — no combined blob in an arbitrary place.
                var groups = StorageGroups();
                if (groups.Count == 0)
                {
                    Snackbar.Add("Load a library first.", Severity.Info);
                    return;
                }

                if (groups.Count == 1)
                {
                    // Single target: _metrics already covers exactly this group's models — reuse it.
                    var g = groups[0];
                    MetricsHistoryStore.Append(g.Path, MetricsSnapshot.From(_metrics, "", timestamp));
                    if (g.Shared) sharedCount++; else anyPerUser = true;
                }
                else
                {
                    _loading = true;
                    StateHasChanged();
                    var graph = LibraryDataService.CombinedGraph;
                    await Task.Run(() =>
                    {
                        foreach (var g in groups)
                        {
                            var metrics = MetricsCalculator.Compute(graph, g.Models);
                            MetricsHistoryStore.Append(g.Path, MetricsSnapshot.From(metrics, "", timestamp));
                        }
                    });
                    sharedCount = groups.Count(g => g.Shared);
                    anyPerUser = groups.Any(g => !g.Shared);
                }
            }
        }
        catch (System.Exception ex)
        {
            Snackbar.Add($"Could not save snapshot: {ex.Message}", Severity.Error);
            return;
        }
        finally
        {
            _loading = false;
        }

        _history = LoadAllHistory();
        RebuildTrend();
        var where = sharedCount > 0
            ? $"{sharedCount} repository .mlqt file(s) — commit them to share with reviewers"
            : "the per-user file (no repository-backed libraries)";
        Snackbar.Add($"Snapshot saved to {where}.", Severity.Success);
        await InvokeAsync(StateHasChanged);
    }

    // Every loaded library grouped by the history file it belongs to (a repository's shared .mlqt file,
    // or the per-user file for non-repo libraries), with that group's model nodes for per-group metrics.
    private List<(string Path, bool Shared, List<ModelNode> Models)> StorageGroups()
    {
        var graph = LibraryDataService.CombinedGraph;
        var byPath = new Dictionary<string, List<ModelNode>>(System.StringComparer.OrdinalIgnoreCase);
        var sharedPaths = new HashSet<string>(System.StringComparer.OrdinalIgnoreCase);

        foreach (var lib in LibraryDataService.Libraries)
        {
            var repo = string.IsNullOrEmpty(lib.RepositoryId)
                ? null
                : RepositoryService.Repositories.FirstOrDefault(r => r.Id == lib.RepositoryId);

            string path;
            if (repo is not null && !string.IsNullOrEmpty(repo.LocalPath))
            {
                path = MetricsHistoryStore.RepoPath(repo.LocalPath);
                sharedPaths.Add(path);
            }
            else
            {
                path = MetricsHistoryStore.DefaultPath;
            }

            if (!byPath.TryGetValue(path, out var list))
                byPath[path] = list = new List<ModelNode>();
            foreach (var id in lib.ModelIds)
            {
                var node = graph.GetNode<ModelNode>(id);
                if (node is not null)
                    list.Add(node);
            }
        }

        return byPath.Select(kv => (kv.Key, sharedPaths.Contains(kv.Key), kv.Value)).ToList();
    }

    // The local path of the repository whose library owns this scope, or null when there is none:
    // a non-empty scope resolves via the library that contains it; an empty scope resolves only when a
    // single repository is loaded (otherwise it spans several).
    private string? OwningRepositoryLocalPath(string scope)
    {
        string? repoId;
        if (!string.IsNullOrEmpty(scope))
        {
            repoId = LibraryDataService.Libraries.FirstOrDefault(l => l.ModelIds.Contains(scope))?.RepositoryId;
        }
        else
        {
            var repoIds = LibraryDataService.Libraries
                .Select(l => l.RepositoryId)
                .Where(id => !string.IsNullOrEmpty(id))
                .Distinct(System.StringComparer.Ordinal)
                .ToList();
            repoId = repoIds.Count == 1 ? repoIds[0] : null;
        }
        if (string.IsNullOrEmpty(repoId))
            return null;
        return RepositoryService.Repositories.FirstOrDefault(r => r.Id == repoId)?.LocalPath;
    }

    // Merge every loaded repository's shared history with the per-user file (which covers file/directory
    // libraries and any pre-existing snapshots). Each snapshot carries its own scope, so RebuildTrend's
    // per-scope filter still applies; ordered by time so the chart/table read chronologically.
    private List<MetricsSnapshot> LoadAllHistory()
    {
        var all = new List<MetricsSnapshot>();
        var seen = new HashSet<string>(System.StringComparer.OrdinalIgnoreCase);
        foreach (var repo in RepositoryService.Repositories)
        {
            if (string.IsNullOrEmpty(repo.LocalPath))
                continue;
            var p = MetricsHistoryStore.RepoPath(repo.LocalPath);
            if (seen.Add(p))
                all.AddRange(MetricsHistoryStore.Load(p));
        }
        all.AddRange(MetricsHistoryStore.Load(MetricsHistoryStore.DefaultPath));
        return all.OrderBy(s => s.TimestampUtc).ToList();
    }

    // The trend for the current scope: its snapshots, and the union of their coverage dimensions. For
    // the "all libraries" scope, per-repository snapshots written together share a timestamp and are
    // combined into one aggregate point (exactly, via their raw counts) so the trend reads as one line.
    private void RebuildTrend()
    {
        var matching = _history.Where(s => (s.Scope ?? "") == _scope).ToList();
        if (string.IsNullOrEmpty(_scope))
            matching = MetricsSnapshot.AggregateByTimestamp(matching);
        _scopedHistory = matching.OrderBy(s => s.TimestampUtc).ToList();
        _dimensions = _scopedHistory.SelectMany(s => s.Coverage.Keys).Distinct().ToList();
    }

    private async Task Compute()
    {
        var all = LibraryDataService.GetAllModels();
        var models = string.IsNullOrEmpty(_scope)
            ? all.ToList()
            : all.Where(m => m.Id == _scope || m.Id.StartsWith(_scope + ".", System.StringComparison.Ordinal)).ToList();
        _modelCount = models.Count;
        _loading = true;
        StateHasChanged();
        try
        {
            var graph = LibraryDataService.CombinedGraph;
            _metrics = await Task.Run(() => MetricsCalculator.Compute(graph, models));
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // Break the current scope into its direct sub-packages and measure each side by side, so a
    // lead can compare across teams. Resolution still uses the full graph, so a sub-package that
    // inherits icons/units from outside its own subtree still scores correctly.
    private async Task ComputeSummary()
    {
        var all = LibraryDataService.GetAllModels().ToList();
        var children = SubPackages(all.Where(m => m.ClassType == "package").Select(m => m.Id));
        if (children.Count == 0)
        {
            Snackbar.Add("No sub-packages to compare in this scope.", Severity.Info);
            return;
        }
        _modelCount = all.Count;
        _loading = true;
        StateHasChanged();
        try
        {
            var graph = LibraryDataService.CombinedGraph;
            _summary = await Task.Run(() => children.Select(pkg =>
            {
                var models = all.Where(m => m.Id == pkg
                    || m.Id.StartsWith(pkg + ".", System.StringComparison.Ordinal)).ToList();
                return (pkg, MetricsCalculator.Compute(graph, models));
            }).ToList());
            _summaryDimensions = _summary.Count > 0
                ? _summary[0].Metrics.Coverage.Select(c => c.Dimension).ToList()
                : new();
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // The direct child packages of the current scope. When no scope is set and a single root
    // library is loaded (e.g. "Modelica"), drill one level into it so MSL breaks straight into its
    // sub-libraries rather than showing a single root row.
    private List<string> SubPackages(IEnumerable<string> packageIds)
    {
        var packages = packageIds.ToHashSet(System.StringComparer.Ordinal);
        string parent;
        if (!string.IsNullOrEmpty(_scope))
        {
            parent = _scope;
        }
        else
        {
            var roots = packages.Where(id => !id.Contains('.')).ToList();
            parent = roots.Count == 1 ? roots[0] : "";
        }
        IEnumerable<string> children = parent.Length == 0
            ? packages.Where(id => !id.Contains('.'))
            : packages.Where(id => id.StartsWith(parent + ".", System.StringComparison.Ordinal)
                                   && id.IndexOf('.', parent.Length + 1) < 0);
        return children.OrderBy(id => id, System.StringComparer.Ordinal).ToList();
    }

    private static string ShortName(string id)
    {
        var i = id.LastIndexOf('.');
        return i < 0 ? id : id[(i + 1)..];
    }

    private void OnLibraryCleared()
    {
        _metrics = null;
        _summary = new();
        InvokeAsync(StateHasChanged);
    }

    private static Color CoverageColor(double percent)
        => percent >= 80 ? Color.Success : percent >= 50 ? Color.Warning : Color.Error;

    private IEnumerable<(string Dim, string Color)> TrendLegend()
        => _dimensions.Select((d, i) => (d, TrendPalette[i % TrendPalette.Length]));

    // The coverage-trend chart as an inline SVG string. Built in code (not markup) because SVG's <text>
    // element collides with Razor's reserved <text> control-flow tag. One polyline per dimension over the
    // scoped snapshots; y is 0–100%, x is snapshot order. Colours/axis use MudBlazor CSS vars so it tracks
    // the theme. Assumes _scopedHistory.Count >= 2 (its only caller guards this).
    private string BuildTrendSvg()
    {
        const double w = 640, h = 240, padL = 34, padR = 12, padT = 10, padB = 26;
        double plotW = w - padL - padR, plotH = h - padT - padB;
        int n = _scopedHistory.Count;
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        string F(double v) => v.ToString("0.#", ci);
        double px(int i) => padL + (n == 1 ? 0 : (double)i / (n - 1) * plotW);
        double py(double pct) => padT + (1 - Math.Clamp(pct, 0, 100) / 100.0) * plotH;

        var sb = new System.Text.StringBuilder();
        sb.Append("<svg viewBox=\"0 0 640 240\" role=\"img\" aria-label=\"Coverage trend\" ")
          .Append("style=\"width:100%;max-width:640px;height:auto;\">");

        for (int g = 0; g <= 4; g++)
        {
            double y = padT + g / 4.0 * plotH;
            int label = 100 - g * 25;
            sb.Append($"<line x1=\"{F(padL)}\" y1=\"{F(y)}\" x2=\"{F(w - padR)}\" y2=\"{F(y)}\" stroke=\"var(--mud-palette-lines-default)\" stroke-width=\"0.5\"/>");
            sb.Append($"<text x=\"{F(padL - 6)}\" y=\"{F(y + 3)}\" text-anchor=\"end\" font-size=\"9\" fill=\"var(--mud-palette-text-secondary)\">{label}</text>");
        }

        for (int idx = 0; idx < _dimensions.Count; idx++)
        {
            var dim = _dimensions[idx];
            var color = TrendPalette[idx % TrendPalette.Length];
            var points = string.Join(" ", _scopedHistory
                .Select((s, i) => (s, i))
                .Where(t => t.s.Coverage.ContainsKey(dim))
                .Select(t => $"{F(px(t.i))},{F(py(t.s.Coverage[dim]))}"));
            if (points.Length > 0)
                sb.Append($"<polyline points=\"{points}\" fill=\"none\" stroke=\"{color}\" stroke-width=\"1.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>");
        }

        var first = _scopedHistory[0].TimestampUtc.ToLocalTime().ToString("yyyy-MM-dd");
        var last = _scopedHistory[^1].TimestampUtc.ToLocalTime().ToString("yyyy-MM-dd");
        sb.Append($"<text x=\"{F(padL)}\" y=\"234\" font-size=\"9\" fill=\"var(--mud-palette-text-secondary)\">{first}</text>");
        sb.Append($"<text x=\"{F(w - padR)}\" y=\"234\" text-anchor=\"end\" font-size=\"9\" fill=\"var(--mud-palette-text-secondary)\">{last}</text>");
        sb.Append("</svg>");
        return sb.ToString();
    }

    public void Dispose()
    {
        NavState.OnLibraryCleared -= OnLibraryCleared;
        LibraryDataService.OnLibrariesChanged -= OnLibrariesChanged;
    }
}
