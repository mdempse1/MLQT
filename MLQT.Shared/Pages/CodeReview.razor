@using ModelicaParser.Helpers
@using System.IO
@using MLQT.Services.Checking
@using System.Text.RegularExpressions
@using Antlr4.Runtime
@using DymolaInterface
@using OpenModelicaInterface
@using RevisionControl
@using ModelicaParser.SpellChecking
@using ModelicaParser.StyleRules

<MudPaper Elevation="0" Class="mt-1">
    <MudStack Row="false" Style="gap:0px !important;">
        <MudStack Row="true">
            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Medium" OverrideStyles="false">
                <MudTooltip Text="View just this version" Arrow="true" Placement="Placement.Bottom">
                    <MudIconButton Icon="@Icons.Material.Filled.Article" Color="Color.Primary" Size="Size.Medium" 
                                Variant="@(!_isDiffMode ? Variant.Filled : Variant.Outlined)" 
                                OnClick="@(() => SetViewMode(false, _diffViewMode))"  />
                </MudTooltip>
                <MudTooltip Text="Side-by-side diff with HEAD version" Arrow="true" Placement="Placement.Bottom">
                    <MudIconButton Icon="@Icons.Material.Filled.Compare" Color="Color.Primary" Size="Size.Medium" Disabled="@(!_isModelModified)"
                                Variant="@(_isDiffMode && _diffViewMode == DiffViewMode.SideBySide ? Variant.Filled : Variant.Outlined)" 
                                OnClick="@(() => SetViewMode(true, DiffViewMode.SideBySide))"  />
                </MudTooltip>
                <MudTooltip Text="Unified diff with HEAD version" Arrow="true" Placement="Placement.Bottom">
                    <MudIconButton Icon="@Icons.Material.Filled.Difference" Color="Color.Primary" Size="Size.Medium" Disabled="@(!_isModelModified)"
                                Variant="@(_isDiffMode && _diffViewMode == DiffViewMode.Unified ? Variant.Filled : Variant.Outlined)" 
                                OnClick="@(() => SetViewMode(true, DiffViewMode.Unified))"  />
                </MudTooltip>
                <MudTooltip Text="View both versions" Arrow="true" Placement="Placement.Bottom">
                    <MudIconButton Icon="@Icons.Material.Filled.VerticalSplit" Color="Color.Primary" Size="Size.Medium" Disabled="@(!_isModelModified)"
                                Variant="@(_isDiffMode && _diffViewMode == DiffViewMode.SideBySideFull ? Variant.Filled : Variant.Outlined)" 
                                OnClick="@(() => SetViewMode(true, DiffViewMode.SideBySideFull))"  />
                </MudTooltip>
            </MudButtonGroup>
            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Medium" OverrideStyles="false">
                <MudTooltip Text="Show/Hide Annotations" Arrow="true" Placement="Placement.Bottom">
                    <MudIconButton Icon="@Icons.Material.Filled.Bookmark" Color="Color.Primary" Variant="@(_showAnnotations ? Variant.Filled : Variant.Outlined)"
                                OnClick="ToggleAnnotations" Size="Size.Medium" />
                </MudTooltip>
                <MudTooltip Text="@(_isExcludedFromFormatting ? "Include in auto-formatting" : "Exclude from auto-formatting")" Arrow="true" Placement="Placement.Bottom">
                    <MudIconButton Icon="@Icons.Material.Filled.FormatClear" Color="@(_isExcludedFromFormatting ? Color.Warning : Color.Primary)"
                                Variant="@(_isExcludedFromFormatting ? Variant.Filled : Variant.Outlined)"
                                OnClick="ToggleFormattingExclusionAsync" Size="Size.Medium"
                                Disabled="@(_currentModelNode == null || string.IsNullOrEmpty(_currentRepositoryId))" />
                </MudTooltip>
            </MudButtonGroup>
            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Medium" OverrideStyles="false">
                <MudTooltip Text="Run Style Checking on ALL classes" Arrow="true" Placement="Placement.Bottom">
                    <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Primary" Variant="Variant.Outlined" 
                                OnClick="RunStyleCheckingAsync" Size="Size.Medium" />
                </MudTooltip>
                @if (!string.IsNullOrEmpty(_settings.Dymola.DymolaPath)) {
                    <MudTooltip Text="Check this class using Dymola" Arrow="true" Placement="Placement.Bottom">
                        <MudIconButton Icon="@_dymolaLogo" Color="Color.Primary" Variant="Variant.Outlined" Disabled=string.IsNullOrEmpty(NavState.ModelID)
                                    OnClick="CheckInDymola" Size="Size.Medium" />
                    </MudTooltip>
                }
                @if (!string.IsNullOrEmpty(_settings.OpenModelica.OmcPath)) {
                    <MudTooltip Text="Check this class using OpenModelica" Arrow="true" Placement="Placement.Bottom">
                        <MudIconButton Icon="@_openModelicaLogo" Color="Color.Primary" Variant="Variant.Outlined" Disabled=string.IsNullOrEmpty(NavState.ModelID)
                                    OnClick="CheckInOpenModelica" Size="Size.Medium" />
                    </MudTooltip>
                }    
            </MudButtonGroup>
        </MudStack>
        @* A recovered class explains itself in the comment at the top of its own source. An alert
           here as well cost the page enough vertical space to push the findings table below the fold,
           which is a poor trade for saying the same thing twice. *@
        @if (_currentModelNode?.HasParserErrors == true)
        {
            <MudAlert Severity="@(_currentModelNode.HasFatalParseFailure ? MudBlazor.Severity.Error : MudBlazor.Severity.Warning)"
                      Dense="true" Class="mt-1 mb-0 py-1">
                @if (_currentModelNode.IsParseFailurePlaceholder)
                {
                    <text>This file could not be parsed. The raw contents are shown below so you can view and fix them — no models were extracted from it. See the Findings panel for the first syntax error.</text>
                }
                else if (_currentModelNode.HasFatalParseFailure)
                {
                    <text>Parsing of this file failed before it completed. Some models were extracted but the code shown may be incomplete. See the Findings panel for the first syntax error.</text>
                }
                else
                {
                    var n = _currentModelNode.Definition.ParserErrors.Count;
                    var first = _currentModelNode.Definition.ParserErrors.FirstOrDefault();
                    var atLine = first != null && first.Line > 0 ? $" (first at line {first.Line})" : "";
                    <text>This model has @n parser @(n == 1 ? "error" : "errors")@atLine. See the Findings panel for details.</text>
                }
            </MudAlert>
        }
        @* Height calculation: 221 px for table, 185px for other stuff*@
        <MudPaper Elevation="1" Style="height: calc(100vh - 405px); display: flex; flex-direction: column;" Class="mt-1 mb-2">
        @if (_isDiffMode)
        {
            @if (_isLoadingDiff)
            {
                <div style="flex: 1; display: flex; align-items: center; justify-content: center;">
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                </div>
            }
            else
            {
                <div style="flex: 1; overflow: hidden;">
                    <DiffViewer OriginalContent="@_originalModelCode"
                                ModifiedContent="@_modifiedModelCode"
                                FileName="model.mo"
                                Height="100%"
                                ContextLines="3"
                                ShowViewModeSelectorButtons="false"
                                ViewMode="@_diffViewMode"
                                ViewModeChanged="@((DiffViewMode mode) => _diffViewMode = mode)" />
                </div>
            }
        }
        else if (_isLoadingCode)
        {
            <div style="flex: 1; display: flex; align-items: center; justify-content: center;">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            </div>
        }
        else
        {
                <CodeViewer Lines="@_highlightedCode" MisspelledWords="@_misspelledWords" Height="100%" />
        }
        </MudPaper>
        <MudPaper Elevation="2" Height="221px" Style="overflow-y: auto; position: relative;">
            <MudTable T="LogMessage" Items="@CodeReviewService.LogMessages" Hover="true" Breakpoint="Breakpoint.Sm"
                Dense="true" FixedHeader="true" OnRowClick="RowClickEvent"
                FixedFooter="true" Filter="new Func<LogMessage,bool>(FilterFunc1)">
                <ToolBarContent>
                    <MudText Typo="Typo.body1">@FindingsHeading</MudText>
                    <MudSpacer />
                    <MudTooltip Text="@ChangesOnlyTooltip">
                        <MudSwitch T="bool" ValueChanged="OnChangesOnlyChanged" Value="@ShowChangesOnly"
                            Label="Changes vs baseline" Color="Color.Primary" Size="Size.Small"
                            Disabled="@(!BaselineStatus.HasBaseline)" />
                    </MudTooltip>
                    <MudSwitch T="bool" ValueChanged="OnFindingsScopeChanged" Value="@FindingsScopeAllModels" Label="Only this model" Color="Color.Primary" Size="Size.Small" />
                    <MudTooltip Text="Export every finding to a JSON file — the whole list, ignoring the filters and search above">
                        <MudIconButton Icon="@Icons.Material.Filled.FileDownload" Size="Size.Small"
                            Color="Color.Default" Disabled="_exporting" OnClick="ExportFindingsAsync"
                            aria-label="Export all findings" />
                    </MudTooltip>
                    <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start"
                        AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small" Class="mt-0 ml-4"
                        Typo="Typo.body1"></MudTextField>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>Model</MudTh>
                    <MudTh>Description</MudTh>
                    <MudTh>Line Number</MudTh>
                    <MudTh>Type</MudTh>
                    @if (BaselineStatus.HasBaseline)
                    {
                        <MudTh>Baseline</MudTh>
                    }
                    <MudTh Style="width:1px;"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Model" Style="text-align: left; vertical-align:top;" Class="compact-table">
                        @MakeShortName(context.ModelName)</MudTd>
                    <MudTd DataLabel="Summary" Style="text-align: left; vertical-align:top;" Class="compact-table">
                        @context.Summary</MudTd>
                    <MudTd DataLabel="Line Number" Style="text-align: left; vertical-align:top;" Class="compact-table">
                        @context.LineNumber</MudTd>
                    <MudTd DataLabel="Type" Style="text-align: left; vertical-align:top;" Class="compact-table">
                        @context.Severity</MudTd>
                    @if (BaselineStatus.HasBaseline)
                    {
                        <MudTd DataLabel="Baseline" Style="text-align: left; vertical-align:top;" Class="compact-table">
                            @{ var status = BaselineStatus.StatusOf(context); }
                            @if (status is not null)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                         Color="@BaselineStatusColour(status.Value)">@BaselineStatusLabel(status.Value)</MudChip>
                            }
                        </MudTd>
                    }
                    <MudTd DataLabel="" Style="text-align: center; vertical-align:top;" Class="compact-table">
                        @if (CanSuppressRule(context))
                        {
                            <div @onclick:stopPropagation="true">
                                <MudTooltip Text="Suppress this rule here (writes a __MLQT annotation into the source)">
                                    <MudIconButton Icon="@Icons.Material.Filled.RuleFolder" Size="Size.Small"
                                        Color="Color.Default" Disabled="_suppressing"
                                        OnClick="@(() => SuppressRuleForFinding(context))" aria-label="Suppress this rule" />
                                </MudTooltip>
                            </div>
                        }
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager HideRowsPerPage="true" PageSizeOptions="new int[] { 5, 10, 25, 50, int.MaxValue }" />
                </PagerContent>
            </MudTable>
        </MudPaper>
    </MudStack>
</MudPaper>

@if (_contextMenuOpen)
{
    <div style="position:fixed; inset:0; z-index:1400;" @onclick="CloseContextMenu"
         @oncontextmenu="CloseContextMenu" @oncontextmenu:preventDefault="true">
        <MudPaper Elevation="8" Class="pa-2 spell-context-menu" @onclick:stopPropagation="true"
            Style="@($"position:fixed; left:{_contextMenuX.ToString(System.Globalization.CultureInfo.InvariantCulture)}px; top:{_contextMenuY.ToString(System.Globalization.CultureInfo.InvariantCulture)}px; min-width:260px; max-width:320px; z-index:1401;")">
            <MudText Typo="Typo.body1" Class="mb-1">Misspelled: <strong>@_contextWord</strong></MudText>

            @if (_suggestions != null && _suggestions.Count > 0)
            {
                <MudText Typo="Typo.body1"><strong>Suggestions</strong></MudText>
                <MudPaper MaxHeight="150px" Style="overflow-y:auto;" Elevation="0" Class="mb-1">
                    @foreach (var suggestion in _suggestions)
                    {
                        @* text-transform:none, not the button default: a suggestion is the word that
                           will be written into the file, so it has to be shown as it will be written.
                           Lower-casing it displayed a name like Pacejka as pacejka — which is itself a
                           misspelling, and looked like what you would get by clicking it. *@
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                            FullWidth="true" Class="justify-start" Style="text-transform: none;"
                            OnClick="@(() => ApplyCorrection(suggestion))">@suggestion</MudButton>
                    }
                </MudPaper>
            }
            else
            {
                <MudText Typo="Typo.caption" Color="Color.Warning" Class="mb-1">No suggestions found</MudText>
            }

            <MudTextField @bind-Value="_customCorrection" Label="Replace with" Variant="Variant.Outlined"
                Margin="Margin.Dense" Immediate="true" Class="mb-1"
                OnKeyDown="OnCustomCorrectionKeyDown" />

            <MudStack Row="true" Style="gap:4px;">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                    Disabled="@(string.IsNullOrWhiteSpace(_customCorrection) || _customCorrection == _contextWord)"
                    OnClick="@(() => ApplyCorrection(_customCorrection))">Apply</MudButton>
                <MudTooltip Text="@(CanAddToDictionary ? "Accept this word for this repository" : NoRepositoryDictionaryTooltip)">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                        Disabled="@(!CanAddToDictionary)"
                        OnClick="AddToDictionary">Add to Dictionary</MudButton>
                </MudTooltip>
                <MudTooltip Text="Accept this word in this class only, recorded in the source as an __MLQT annotation">
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                        Disabled="@_suppressing"
                        OnClick="IgnoreSpellingFinding">Ignore</MudButton>
                </MudTooltip>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                    OnClick="CloseContextMenu">Close</MudButton>
            </MudStack>
        </MudPaper>
    </div>
}

<MudDialog @bind-Visible="_checkProgressDialog" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@_checkingToolName Check Progress - @_modelsChecked checked out of @_modelsToCheck</MudText>
    </TitleContent>
    <DialogContent>
        <MudProgressLinear Indeterminate="false" Min=0 Max=@_modelsToCheck Value=@_modelsChecked />
        <MudText Class="mt-2" Typo="Typo.body1">Checking model:</MudText>
        <MudText Class="mt-0" Typo="Typo.body1">@_checkingModel</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CloseCheckProgressDialog"
            Class="px-10">Stop</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_findingDetailsVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.subtitle2">Finding in @_currentFinding!.ModelName</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Class="mt-2" Typo="Typo.body1">@_currentFinding!.Summary</MudText>
        <MudText Class="mt-2" Typo="Typo.body1">@_currentFinding!.Severity on line @_currentFinding.LineNumber</MudText>
        @if (_currentFinding!.Details?.Length > 0)
        {
            <MudText Class="mt-2" Typo="Typo.body1">Details:</MudText>
            <MudText Class="mt-2 pre-wrap" Typo="Typo.body1">@_currentFinding.Details</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudStack Row="true">
            @if (IsSpellingFinding(_currentFinding))
            {
                <MudTooltip Text="@(CanAddToDictionary ? "Accept this word for this repository" : NoRepositoryDictionaryTooltip)">
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Disabled="@(!CanAddToDictionary)"
                        OnClick="AddToDictionary" Class="px-10">Add to Dictionary</MudButton>
                </MudTooltip>
            }
            @if (CanSuppressRule(_currentFinding))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="@(() => SuppressRuleForFinding(_currentFinding))"
                           Disabled="_suppressing" StartIcon="@Icons.Material.Filled.RuleFolder" Class="px-10">Suppress
                </MudButton>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ResolveFinding" Class="px-10">Resolve
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CloseFindingDialog" Class="px-10">Close
            </MudButton>
        </MudStack>
    </DialogActions>
</MudDialog>
