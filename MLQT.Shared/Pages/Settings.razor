@inject ISettingsService SettingsService
@inject IJSRuntime JSRuntime
@inject AppState NavState

<MudPaper Elevation="0" Class="mt-1">
    <MudTabs Outlined="true" MinimumTabWidth="50px" Rounded="true" @bind-ActivePanelIndex="_activePanelIndex">
        <!-- UI Settings Tab -->
        <MudTabPanel Text="UI Settings" Icon="@Icons.Material.Filled.SettingsBrightness" ToolTip="User Interface Settings">
            <SettingsUI @ref="_uiSettings" />
        </MudTabPanel>

        <!-- External Tools Settings Tab -->
        <MudTabPanel Text="External Tools" Icon="@Icons.Material.Filled.Build" ToolTip="External Tool Settings">
            <SettingsExternalTools @ref="_externalToolsSettings" />
        </MudTabPanel>

        <!-- Reference Libraries Tab -->
        <MudTabPanel Text="Reference Libraries" Icon="@Icons.Material.Filled.LibraryBooks" ToolTip="Read-only libraries used to resolve references">
            <SettingsReferenceLibraries @ref="_referenceLibrarySettings" />
        </MudTabPanel>

        <!-- Repository Settings Tab -->
        <MudTabPanel Text="Manage Repositories" Icon="@Icons.Material.Filled.Build" ToolTip="Manage Repository Settings">
            <SettingsRepositories />
        </MudTabPanel>
    </MudTabs>

    <!-- Action Buttons, not displayed on the Repository Settings tab -->
    @if (_activePanelIndex != RepositoriesTabIndex)
    {
        <MudPaper Class="pa-2 mt-2" Elevation="0">
            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveSettings" StartIcon="@Icons.Material.Filled.Save" Size="Size.Small">
                    Save Settings
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ResetToDefaults" StartIcon="@Icons.Material.Filled.RestartAlt" Size="Size.Small">
                    Reset to Defaults
                </MudButton>
            </MudStack>
        </MudPaper>
    }
</MudPaper>

    @code {
    // The Manage Repositories tab manages its own persistence and shows no Save/Reset buttons.
    // Named rather than written as a literal so inserting a tab before it cannot silently point
    // the check at the wrong panel.
    private const int RepositoriesTabIndex = 3;

    private int _activePanelIndex = 0;

    private SettingsUI? _uiSettings;
    private SettingsExternalTools? _externalToolsSettings;
    private SettingsReferenceLibraries? _referenceLibrarySettings;

    private async Task SaveSettings()
    {
        try
        {
            NavState.SaveSettings();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving settings: {ex.Message}");
        }
    }

    private async Task ResetToDefaults()
    {
        // Restore only the currently active tab's settings to their defaults.
        // The Manage Repositories tab has no action buttons, so it is never reset here.
        try
        {
            switch (_activePanelIndex)
            {
                case 0:
                    if (_uiSettings is not null)
                        await _uiSettings.ResetToDefaultsAsync();
                    break;
                case 1:
                    if (_externalToolsSettings is not null)
                        await _externalToolsSettings.ResetToDefaultsAsync();
                    break;
                case 2:
                    if (_referenceLibrarySettings is not null)
                        await _referenceLibrarySettings.ResetToDefaultsAsync();
                    break;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error resetting settings: {ex.Message}");
        }
    }
}
