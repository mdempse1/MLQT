@using System.Threading.Tasks


<MudPaper Elevation="0">
    <!-- UI Themes -->
    <MudText Typo="Typo.subtitle1" Class="ml-2 mt-4 mb-2">UI Theme</MudText>
    <MudButtonGroup Variant="Variant.Outlined" Class="mb-4">
        <MudButton
            OnClick="@(() => ApplyPresetUITheme("Light"))"
            Size="Size.Small"
            StartIcon="@(_settings.UI.Theme==Theme.Light ? Icons.Material.Filled.Check : string.Empty)" >
            Light
        </MudButton>
        <MudButton
            OnClick="@(() => ApplyPresetUITheme("Dark"))"
            Size="Size.Small"
            StartIcon="@(_settings.UI.Theme==Theme.Dark ? Icons.Material.Filled.Check : string.Empty)" >
            Dark
        </MudButton>
        <MudButton
            OnClick="@(() => ApplyPresetUITheme("Custom"))"
            Size="Size.Small"
            StartIcon="@(_settings.UI.Theme==Theme.Custom ? Icons.Material.Filled.Check : string.Empty)" >
            Custom
        </MudButton>
    </MudButtonGroup>

    @if (_customUIStyles)
    {
        <MudText Typo="Typo.subtitle1" Class="ml-2 mt-4 mb-2">Custom UI Theme</MudText>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <ColorPicker Label="Black" Value="@_settings.UI.CustomBlack" ValueChanged="OnBlackChanged" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <ColorPicker Label="White" Value="@_settings.UI.CustomWhite" ValueChanged="OnWhiteChanged" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <ColorPicker Label="Primary" Value="@_settings.UI.CustomPrimary" ValueChanged="OnPrimaryChanged" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <ColorPicker Label="Primary Contrast Text" Value="@_settings.UI.CustomPrimaryContrastText" ValueChanged="OnPrimaryContrastTextChanged" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <ColorPicker Label="Secondary" Value="@_settings.UI.CustomSecondary" ValueChanged="OnSecondaryChanged" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <ColorPicker Label="Secondary Contrast Text" Value="@_settings.UI.CustomSecondaryContrastText" ValueChanged="OnSecondaryContrastTextChanged" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <ColorPicker Label="Tertiary" Value="@_settings.UI.CustomTertiary" ValueChanged="OnTertiaryChanged" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <ColorPicker Label="Tertiary Contrast Text" Value="@_settings.UI.CustomTertiaryContrastText" ValueChanged="OnTertiaryContrastTextChanged" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <ColorPicker Label="Info" Value="@_settings.UI.CustomInfo" ValueChanged="OnInfoChanged" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <ColorPicker Label="Info Contrast Text" Value="@_settings.UI.CustomInfoContrastText" ValueChanged="OnInfoContrastTextChanged" />
            </MudItem>
        </MudGrid>
    }

    <!-- Startup Analysis -->
    <MudText Typo="Typo.subtitle1" Class="ml-2 mt-4 mb-2">Startup Analysis</MudText>
    <MudNumericField T="int" @bind-Value="_settings.UI.DeferAnalysisThreshold"
                     Label="Defer analysis threshold (model count)"
                     HelperText="When a project has more models than this threshold, formatting, dependency analysis, style checking, and external resource analysis are deferred on startup."
                     Variant="Variant.Outlined" Margin="Margin.Dense"
                     Min="100" Max="100000" Step="100"
                     Typo="Typo.body1" Class="mb-4" Style="max-width: 400px;" />

    <!-- Syntax Highlighting Themes -->
    <MudText Typo="Typo.subtitle1"  Class="ml-2 mt-4 mb-2">Syntax Highlighting</MudText>
    <MudButtonGroup Variant="Variant.Outlined" Class="mb-4">
        <MudButton 
            OnClick="@(() => ApplyPresetSyntaxTheme("VSCode"))" 
            Size="Size.Small" 
            StartIcon="@(_settings.SyntaxHighlighting.ThemeName=="VSCode" ? Icons.Material.Filled.Check : string.Empty)">
            VS Code
        </MudButton>   
        <MudButton 
            OnClick="@(() => ApplyPresetSyntaxTheme("Dymola"))" 
            Size="Size.Small"
            StartIcon="@(_settings.SyntaxHighlighting.ThemeName=="Dymola" ? Icons.Material.Filled.Check : string.Empty)">
            Dymola
        </MudButton>
        <MudButton 
            OnClick="@(() => ApplyPresetSyntaxTheme("OpenModelica"))" 
            Size="Size.Small"
            StartIcon="@(_settings.SyntaxHighlighting.ThemeName=="OpenModelica" ? Icons.Material.Filled.Check : string.Empty)">
            OpenModelica
        </MudButton>
        <MudButton 
            OnClick="@(() => SetCustomSyntaxTheme())" 
            Size="Size.Small"
            StartIcon="@(_settings.SyntaxHighlighting.ThemeName=="Custom" ? Icons.Material.Filled.Check : string.Empty)">
            Custom
        </MudButton>
    </MudButtonGroup>

    @if (_customSyntaxStyles) 
    {
        <!-- Editor Background -->
        <MudText Typo="Typo.subtitle1" Class="ml-2 mt-4 mb-2">Custom Syntax Highlighting Theme</MudText>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <ColorPicker Label="Background Color" Value="@_settings.SyntaxHighlighting.BackgroundColor" ValueChanged="OnBackgroundChanged" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <ColorPicker Label="Text Color" Value="@_settings.SyntaxHighlighting.TextColor" ValueChanged="OnTextChanged" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <ColorPicker Label="Border Color" Value="@_settings.SyntaxHighlighting.BorderColor" ValueChanged="OnBorderChanged" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <ColorPicker Label="Line Number Color" Value="@_settings.SyntaxHighlighting.LineNumberColor" ValueChanged="OnLineNumberChanged" />
            </MudItem>
        </MudGrid>

        <!-- Syntax Element Colors -->
        <MudText Typo="Typo.subtitle2" Class="mt-2 mb-2">Syntax Element Colors</MudText>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <ColorPicker Label="Keywords (model, end, etc.)" Value="@_settings.SyntaxHighlighting.KeywordColor" ValueChanged="OnKeywordChanged" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <ColorPicker Label="Types" Value="@_settings.SyntaxHighlighting.TypeColor" ValueChanged="OnTypesChanged" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <ColorPicker Label="Identifiers" Value="@_settings.SyntaxHighlighting.IdentColor" ValueChanged="OnIdentifiersChanged" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <ColorPicker Label="Names" Value="@_settings.SyntaxHighlighting.NameColor" ValueChanged="OnNamesTextChanged" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <ColorPicker Label="Functions" Value="@_settings.SyntaxHighlighting.FunctionColor" ValueChanged="OnFunctionsChanged" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <ColorPicker Label="Operators" Value="@_settings.SyntaxHighlighting.OperatorColor" ValueChanged="OnOperatorsChanged" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <ColorPicker Label="Numbers" Value="@_settings.SyntaxHighlighting.NumberColor" ValueChanged="OnNumbersChanged" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <ColorPicker Label="Strings" Value="@_settings.SyntaxHighlighting.StringColor" ValueChanged="OnStringsChanged" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <ColorPicker Label="Comments" Value="@_settings.SyntaxHighlighting.CommentColor" ValueChanged="OnCommentsChanged" />
            </MudItem>
        </MudGrid>
    }

    <!-- Preview -->
    <div class="code-preview" style="@GetPreviewStyle()">
        <div style="padding: 1rem; font-family: 'Consolas', 'Monaco', 'Courier New', monospace; font-size: var(--mud-typography-body1-size);">
            <div><span style="color: @_settings.SyntaxHighlighting.KeywordColor; font-weight: 600;">model</span> <span style="color: @_settings.SyntaxHighlighting.NameColor;">Example</span></div>
            <div>&nbsp;&nbsp;<span style="color: @_settings.SyntaxHighlighting.CommentColor; font-style: italic;">// This is a comment</span></div>
            <div>&nbsp;&nbsp;<span style="color: @_settings.SyntaxHighlighting.KeywordColor; font-weight: 600;">parameter</span> <span style="color: @_settings.SyntaxHighlighting.TypeColor;">Real</span> <span style="color: @_settings.SyntaxHighlighting.IdentColor;">x</span> <span style="color: @_settings.SyntaxHighlighting.OperatorColor;">=</span> <span style="color: @_settings.SyntaxHighlighting.NumberColor;">3.14</span>;</div>
            <div>&nbsp;&nbsp;<span style="color: @_settings.SyntaxHighlighting.TypeColor;">String</span> <span style="color: @_settings.SyntaxHighlighting.IdentColor;">name</span> <span style="color: @_settings.SyntaxHighlighting.OperatorColor;">=</span> <span style="color: @_settings.SyntaxHighlighting.StringColor;">"Modelica"</span>;</div>
            <div><span style="color: @_settings.SyntaxHighlighting.KeywordColor; font-weight: 600;">end</span> <span style="color: @_settings.SyntaxHighlighting.NameColor;">Example</span>;</div>
        </div>
    </div>
</MudPaper>
