@using MLQT.Services
@using MLQT.Services.DataTypes
@implements IDisposable

@inject ISettingsService SettingsService
@inject IFilePickerService FilePickerService
@inject AppState NavState
@inject ISnackbar Snackbar

<MudPaper Elevation="0">
    <MudText Typo="Typo.body1" Class="ml-2 mt-4">
        Libraries loaded read-only so that references out of your own code resolve — typically a tool's
        installed library folder, such as Dymola's <code>Modelica\Library</code>. They are never checked,
        formatted or written to.
    </MudText>
    <MudText Typo="Typo.body1" Class="ml-2 mt-2">
        Commercial libraries ship encrypted (a <code>package.moe</code> with no readable source). Where
        one includes the vendor's generated documentation, MLQT recovers its class names, descriptions,
        base classes and icons from that — enough for references into it to resolve and for icons
        inherited from it to be seen.
    </MudText>

    <MudSwitch @bind-Value="@_settings.UseEncryptedLibraryDocumentation"
               Color="Color.Primary"
               Size="Size.Small"
               Class="ml-2 mt-4"
               Label="Recover encrypted libraries from their documentation" />

    <MudText Typo="Typo.subtitle1" Class="ml-2 mt-4">Library folders</MudText>

    @if (_settings.Paths.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
            No reference libraries configured. References into libraries you have not loaded will be
            reported as unresolved.
        </MudAlert>
    }
    else
    {
        <MudTable Items="@_settings.Paths" Dense="true" Hover="true" Elevation="0" Class="mt-2">
            <HeaderContent>
                <MudTh>Path</MudTh>
                <MudTh Style="width: 12rem;">Libraries found</MudTh>
                <MudTh Style="width: 4rem;"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Path">
                    <MudText Typo="Typo.body1">@context</MudText>
                </MudTd>
                <MudTd DataLabel="Libraries found">
                    <MudText Typo="Typo.body1">@DescribeFolder(context)</MudText>
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   OnClick="@(() => RemovePath(context))" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

    <MudButton Variant="Variant.Outlined"
               Size="Size.Small"
               StartIcon="@Icons.Material.Filled.FolderOpen"
               OnClick="AddPath"
               Class="ml-2 mt-4">
        Add folder
    </MudButton>

    <MudText Typo="Typo.body1" Class="ml-2 mt-4">
        Changes take effect the next time the project is loaded.
    </MudText>
</MudPaper>

@code {
    private ReferenceLibrarySettings _settings = new();

    protected override void OnInitialized()
    {
        NavState.OnSaveSettings += SaveOnRequest;
        base.OnInitialized();
    }

    public void Dispose() => NavState.OnSaveSettings -= SaveOnRequest;

    protected override async Task OnInitializedAsync()
    {
        _settings = await SettingsService.GetAsync("ReferenceLibraries", new ReferenceLibrarySettings());
    }

    // The folder list saves as it is edited, but the switch does not, and the page's Save button
    // must mean what it says on every tab.
    private void SaveOnRequest() => _ = SaveAsync();

    /// <summary>
    /// What a configured folder actually contributes, so a mistyped or moved path is visible here
    /// rather than only as unresolved references much later.
    /// </summary>
    private string DescribeFolder(string path)
    {
        if (string.IsNullOrWhiteSpace(path) || !Directory.Exists(path))
            return "folder not found";

        try
        {
            var libraries = LibraryDiscovery.DiscoverLibraryPaths(path);
            if (libraries.Count == 0)
                return "no libraries found";

            var encrypted = libraries.Count(EncryptedLibraryDetector.IsEncryptedLibraryRoot);
            return encrypted == 0
                ? $"{libraries.Count} librar{(libraries.Count == 1 ? "y" : "ies")}"
                : $"{libraries.Count} ({encrypted} encrypted)";
        }
        catch (Exception)
        {
            return "could not be read";
        }
    }

    private async Task AddPath()
    {
        var folder = await FilePickerService.PickFolderAsync("Select a folder containing Modelica libraries");
        if (string.IsNullOrEmpty(folder))
            return;

        if (_settings.Paths.Contains(folder, StringComparer.OrdinalIgnoreCase))
        {
            Snackbar.Add("That folder is already configured.", Severity.Info);
            return;
        }

        _settings.Paths.Add(folder);
        await SaveAsync();
    }

    private async Task RemovePath(string path)
    {
        _settings.Paths.Remove(path);
        await SaveAsync();
    }

    /// <summary>Persists the settings. Called by the Settings page's Save button.</summary>
    public async Task SaveSettingsAsync() => await SaveAsync();

    /// <summary>Clears the configured reference libraries and persists that.</summary>
    public async Task ResetToDefaultsAsync()
    {
        _settings = new ReferenceLibrarySettings();
        await SaveAsync();
    }

    private async Task SaveAsync()
    {
        try
        {
            await SettingsService.SetAsync("ReferenceLibraries", _settings);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not save reference library settings: {ex.Message}", Severity.Error);
        }
    }
}
