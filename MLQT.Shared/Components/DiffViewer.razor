@*
    DiffViewer Component
    Displays differences between two versions of a file with syntax highlighting for Modelica files
*@

<div class="diff-viewer @(_isDarkMode ? "diff-viewer-dark" : "")" style="@GetContainerStyle()">
    <div class="diff-toolbar">
        @if (ShowViewModeSelectorButtons) 
        {
            <MudButtonGroup OverrideStyles="false" Size="Size.Small">
                <MudButton Variant="@(ViewMode == DiffViewMode.Unified ? Variant.Filled : Variant.Outlined)"
                        Size="Size.Small" Color="Color.Primary" OnClick="@(() => SetViewMode(DiffViewMode.Unified))">
                    Unified
                </MudButton>
                <MudButton Variant="@(ViewMode == DiffViewMode.SideBySide ? Variant.Filled : Variant.Outlined)"
                        Size="Size.Small" Color="Color.Primary" OnClick="@(() => SetViewMode(DiffViewMode.SideBySide))">
                    Side by Side
                </MudButton>
                <MudButton Variant="@(ViewMode == DiffViewMode.SideBySideFull ? Variant.Filled : Variant.Outlined)"
                        Size="Size.Small" Color="Color.Primary" OnClick="@(() => SetViewMode(DiffViewMode.SideBySideFull))">
                    Full Files
                </MudButton>
            </MudButtonGroup>
            <MudSpacer />
        }
        <MudText Typo="Typo.body1" Class="ml-2">
            @GetDiffSummary()
        </MudText>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="diff-empty" style="padding: 16px;">
            <MudAlert Severity="Severity.Warning" Dense="true">@_errorMessage</MudAlert>
        </div>
    }
    else if (string.IsNullOrEmpty(OriginalContent) && string.IsNullOrEmpty(ModifiedContent))
    {
        <div class="diff-empty">
            <MudText Typo="Typo.body2" Color="Color.Secondary">No content to display</MudText>
        </div>
    }
    else if (ViewMode == DiffViewMode.Unified)
    {
        <div class="diff-unified">
            @foreach (var line in _unifiedLines)
            {
                <div class="diff-line @GetLineClass(line.Type)">
                    <span class="diff-line-prefix">@line.Prefix</span>
                    <span class="diff-line-number">@line.LineNumber</span>
                    <span class="diff-line-content">@((MarkupString)ParseContent(line.Content))</span>
                </div>
            }
        </div>
    }
    else
    {
        <div class="diff-side-by-side">
            <div class="diff-pane diff-pane-left">
                <div class="diff-pane-header">@OriginalLabel</div>
                <div class="diff-pane-content" @ref="_leftPaneRef">
                    @foreach (var line in _leftLines)
                    {
                        <div class="diff-line @GetLineClass(line.Type)">
                            <span class="diff-line-number">@line.LineNumber</span>
                            <span class="diff-line-content">@((MarkupString)ParseContent(line.Content))</span>
                        </div>
                    }
                </div>
            </div>
            <div class="diff-pane diff-pane-right">
                <div class="diff-pane-header">@ModifiedLabel</div>
                <div class="diff-pane-content" @ref="_rightPaneRef">
                    @foreach (var line in _rightLines)
                    {
                        <div class="diff-line @GetLineClass(line.Type)">
                            <span class="diff-line-number">@line.LineNumber</span>
                            <span class="diff-line-content">@((MarkupString)ParseContent(line.Content))</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
