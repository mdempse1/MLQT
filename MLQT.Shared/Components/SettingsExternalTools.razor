@using DymolaInterface
@using OpenModelicaInterface
@using System.Threading.Tasks


<MudPaper Elevation="0">
    <MudText Typo="Typo.subtitle1" Class="ml-2 mt-4">Dymola</MudText>
    <MudTextField @bind-Value="@_settings.Dymola.DymolaPath"
                    Label="Path to Dymola Executable"
                    Variant="Variant.Outlined"
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.FolderOpen"
                    OnAdornmentClick="BrowseForDymolaFolder"
                    Margin="Margin.Dense"
                    Typo="Typo.body1" 
                    ShrinkLabel="true"
                    Class="mt-4"/>
    @if (_showDymolaWarning) 
    {
        <MudAlert Severity="Severity.Warning">Could not find Dymola at @_settings.Dymola.DymolaPath</MudAlert>
    }

    <MudNumericField @bind-Value="@_settings.Dymola.PortNumber"
                    Label="Port Number"
                    Variant="Variant.Outlined"
                    Margin="Margin.Dense"
                    Min="1" Max="65535"
                    Typo="Typo.body1" 
                    ShrinkLabel="true"
                    Class="mt-4"/>


    <MudText Typo="Typo.subtitle1" Class="ml-2 mt-4">OpenModelica</MudText>
    <MudTextField @bind-Value="@_settings.OpenModelica.OmcPath"
                    Label="Path to OpenModelica Compiler Executable"
                    Variant="Variant.Outlined"
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.FolderOpen"
                    OnAdornmentClick="BrowseForOpenModelicaFolder"
                    Margin="Margin.Dense"
                    Typo="Typo.body1" 
                    ShrinkLabel="true"
                    Class="mt-4"/>
    @if (_showOpenModelicaWarning) 
    {
        <MudAlert Severity="Severity.Warning">Could not find OpenModelica at @_settings.OpenModelica.OmcPath</MudAlert>
    }

    <MudNumericField @bind-Value="@_settings.OpenModelica.PortNumber"
                    Label="Port Number"
                    Variant="Variant.Outlined"
                    Margin="Margin.Dense"
                    Min="1" Max="65535"
                    Typo="Typo.body1" 
                    ShrinkLabel="true"
                    Class="mt-4"/>
</MudPaper>
