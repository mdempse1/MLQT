@*
    CodeViewer Component
    Displays syntax-highlighted Modelica code using markup tags from ModelicaSyntaxVisitor
*@

<div class="code-viewer" style="@(!string.IsNullOrEmpty(Height) ? $"height: {Height};" : string.Empty)" @ref="_viewer">
    <div class="code-viewer-content">
        @if (_htmlLines != null && _htmlLines.Count > 0)
        {
            @for (var i = 0; i < _htmlLines.Count; i++)
            {
                var lineNumber = i + 1;
                <div class="@LineClass(lineNumber)" data-line="@lineNumber">
                    @((MarkupString)_htmlLines[i])
                </div>
            }
        }
    </div>
</div>
