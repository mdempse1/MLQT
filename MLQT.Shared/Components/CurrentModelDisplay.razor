<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
    @* The back and forward arrows used to be here (B197), beside the name of the class they act on,
       because every tab moves the selection and the history is one history. They moved to the Code
       Review toolbar for B249, so that the "go to a class this one uses" button's tooltip names an
       arrow the user can actually see.

       **What that costs, stated plainly**: the other four tabs move the selection and no longer
       offer a way back. The history itself is still shared — `AppState` owns it — so returning to
       Code Review finds it intact. If that turns out to be the wrong trade, the other direction is
       to bring the used-classes menu up here rather than send the arrows down. *@
    <MudTextField @bind-Value="_currentModelName" Label="Current class:" Variant="Variant.Outlined" ReadOnly="true" Margin="Margin.Dense" Typo="Typo.body1" ShrinkLabel="true"/>
    @if (!string.IsNullOrEmpty(_currentModelFileName))
    {
        <MudTooltip Text="@_currentModelFileName" Placement="Placement.Left">
            <MudIcon Icon="@Icons.Material.Outlined.Article" Color="Color.Primary" Size="Size.Large" Class="mt-2"/>
        </MudTooltip>
    }
</MudStack>
