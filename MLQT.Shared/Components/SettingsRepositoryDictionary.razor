@using MLQT.Services
@using MLQT.Services.DataTypes


@if (Repository is null)
{
    return;
}

<MudExpansionPanels Class="mt-2 pa-0 ml-0 mr-0" Dense="true" Gutters="false" Elevation="2">
    <MudExpansionPanel Text="" Dense="true" Class="ma-0 pa-0">
        <TitleContent>
            <MudText Typo="Typo.subtitle2" Class="mt-4">
                Accepted spellings (@_words.Count @(_words.Count == 1 ? "word" : "words"))
            </MudText>
        </TitleContent>
        <ChildContent>
            <MudText Typo="Typo.body1" Class="mb-2">
                Stored in this repository at <code>.mlqt/dictionary.txt</code> and committed with the
                code, so the app and CI accept exactly the same words. A word applies only to this
                repository — the same term used in another one has to be accepted there too.
            </MudText>

            <MudStack Row="true" Class="mb-2" Spacing="1" Style="width: fit-content;" AlignItems="AlignItems.Center">
                <MudTextField @bind-Value="_newWord" Placeholder="Add a word" Variant="Variant.Outlined"
                    Margin="Margin.Dense" Typo="Typo.body1" Style="width: 200px;" Immediate="true"
                    OnKeyDown="OnAddWordKeyDown" />
                <MudIconButton Icon="@Icons.Material.Outlined.Add" Variant="Variant.Outlined" Color="Color.Primary"
                    Size="Size.Medium" OnClick="AddWord" Disabled="@string.IsNullOrWhiteSpace(_newWord)" />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                    OnClick="ImportFromFile">Import</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                    OnClick="ExportToFile">Export</MudButton>
                @if (CustomDictionaryService.LegacyMachineDictionaryPath is not null)
                {
                    <MudTooltip Text="@($"Copy the words from the old machine-wide list at {CustomDictionaryService.LegacyMachineDictionaryPath} into this repository. It is no longer used for checking.")">
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                            OnClick="ImportMachineDictionary">Import machine list</MudButton>
                    </MudTooltip>
                }
            </MudStack>

            <MudTextField T="string" Value="_filter" ValueChanged="OnFilterChanged" Placeholder="Filter words"
                Variant="Variant.Outlined" Margin="Margin.Dense" Typo="Typo.body1"
                Immediate="true" Class="mb-2" Style="width: 200px;" />

            <MudChipSet T="string" Class="mt-1">
                @foreach (var word in _filtered)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             OnClose="() => RemoveWord(word)">@word</MudChip>
                }
            </MudChipSet>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
