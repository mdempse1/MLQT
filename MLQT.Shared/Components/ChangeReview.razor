@using ModelicaParser.Helpers
@using System.Threading.Tasks
@using System.ComponentModel.DataAnnotations.Schema

@using RevisionControl


@if (!IsLoading && ChangedFiles.Count > 0)
{
<MudGrid Spacing="1">
    <!-- Left side: File tree -->
    <MudItem xs="4">
        <MudPaper Outlined="true" Class="pa-2" Style="height: 350px; display: flex; flex-direction: column;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.subtitle2">Changed Files (@ChangedFiles.Count)</MudText>
                <MudSpacer />
                <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined">
                    <MudTooltip Text="Select All">
                        <MudIconButton OnClick="SelectAllFiles" Icon="@Icons.Material.Filled.DoneAll" Size="Size.Small" Color="Color.Primary"/>
                    </MudTooltip>
                    <MudTooltip Text="Deselect All">
                        <MudIconButton OnClick="DeselectAllFiles" Icon="@Icons.Material.Filled.CheckBoxOutlineBlank" Size="Size.Small" Color="Color.Primary" />
                    </MudTooltip>
                </MudButtonGroup>
            </MudStack>
            <div style="flex: 1; overflow-y: auto;">
                <MudTreeView T="FileTreeNode"
                                Items="@_treeItems"
                                ServerData="@LoadServerData"
                                Dense="true"
                                Hover="true"
                                ExpandOnClick="true"
                                SelectedValueChanged="OnTreeNodeSelected">
                    <ItemTemplate Context="node">
                        <MudTreeViewItem T="FileTreeNode"
                                            Value="@node.Value"
                                            Items="@node.Children"
                                            ItemsChanged="@(new Action<IReadOnlyCollection<ITreeItemData<FileTreeNode>>>(items => OnNodeChildrenLoaded(node, items)))"
                                            Expanded="@node.Expanded"
                                            ExpandedChanged="@((bool expanded) => OnExpandNode(node, expanded))"
                                            CanExpand="@node.Expandable">
                            <BodyContent>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Style="width: 100%;" Spacing="0">
                                    @if (node.Value!.IsFile)
                                    {
                                        <span @onclick:stopPropagation="true">
                                            <MudCheckBox T="bool"
                                                            Value="@_selectedFiles.Contains(node.Value.FullPath)"
                                                            ValueChanged="@((bool val) => OnFileSelectionChanged(node.Value.FullPath, val))"
                                                            Dense="true"
                                                            Size="Size.Small"
                                                            Color="Color.Primary" />
                                        </span>
                                    }
                                    else
                                    {
                                        <span @onclick:stopPropagation="true">
                                            <MudCheckBox T="bool?"
                                                            Value="@GetFolderCheckState(node.Value!)"
                                                            ValueChanged="@((bool? val) => OnFolderSelectionChanged(node.Value!, val ?? false))"
                                                            Dense="true"
                                                            Size="Size.Small"
                                                            Color="Color.Primary"
                                                            TriState="true" />
                                        </span>
                                    }
                                    <MudIcon Icon="@(node.Value.IsFile ? VcsStatusHelper.GetStatusIcon(node.Value.Status ?? VcsFileStatus.Modified) : Icons.Material.Filled.Folder)"
                                                Size="Size.Small"
                                                Color="@(node.Value.IsFile ? VcsStatusHelper.GetStatusColor(node.Value.Status ?? VcsFileStatus.Modified) : Color.Warning)"
                                                Class="mr-1" />
                                    <MudTooltip Text="@node.Value.FullPath">
                                        <MudText Typo="Typo.body1">
                                            @node.Value.Name
                                        </MudText>
                                    </MudTooltip>
                                    @if (node.Value.IsFile && node.Value.Status.HasValue)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="@VcsStatusHelper.GetStatusColor(node.Value.Status.Value)"
                                                    Variant="Variant.Text" Style="height: 18px; font-size: 0.65rem; margin-left: 4px;">
                                            @VcsStatusHelper.GetStatusText(node.Value.Status.Value)
                                        </MudChip>
                                    }
                                </MudStack>
                            </BodyContent>
                        </MudTreeViewItem>
                    </ItemTemplate>
                </MudTreeView>
            </div>
        </MudPaper>
    </MudItem>

    <!-- Right side: Diff view -->
    <MudItem xs="8">
        <MudPaper Outlined="true" Style="height: 350px; display: flex; flex-direction: column;">
            @if (string.IsNullOrEmpty(_selectedFilePath))
            {
                <MudText Typo="Typo.body1" Class="mt-2 ml-2">Select a file to view changes</MudText>
            }
            else if (_isLoadingDiff)
            {
                <div style="display: flex; align-items: center; justify-content: center; height: 100%;">
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                </div>
            }
            else
            {
                <MudText Typo="Typo.body1" Class="ma-2"><strong>Path:</strong> @_selectedFilePath</MudText>
                <div style="flex: 1; overflow: hidden;">
                    <DiffViewer OriginalContent="@_originalContent"
                                ModifiedContent="@_modifiedContent"
                                FileName="@_selectedFilePath"
                                Height="100%"
                                ContextLines="3"
                                ViewMode="@_diffViewMode"
                                ViewModeChanged="@((mode) => _diffViewMode = mode)" />
                </div>
            }
        </MudPaper>
    </MudItem>
</MudGrid>
}
