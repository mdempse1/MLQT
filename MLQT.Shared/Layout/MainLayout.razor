        await Task.Run(RunDeferredExternalResourcesAsync);
        _step5running = false;
        _runningDeferredStep = false;
        //Check to see if the dialog should stay open
        if (!_step3deferred && !_step4deferred && !_step5deferred)
            _startupProcessRunning = false;
