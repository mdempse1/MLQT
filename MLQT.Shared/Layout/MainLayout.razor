@using ModelicaParser.Helpers
@using MLQT.Shared.Pages
@using DymolaInterface
@using OpenModelicaInterface
@using System.IO
@using System.Collections.Concurrent
@using System.Reflection
@using System.Runtime
@using static MLQT.Services.LoggingService
@using MLQT.Services.Checking
@using RevisionControl
@inherits LayoutComponentBase

<MudThemeProvider Theme="@_myTheme" @bind-IsDarkMode="@_isDarkMode" />
<MudDialogProvider BackdropClick="false" CloseOnEscapeKey="false" MaxWidth="MaxWidth.Large" />
<MudPopoverProvider />
<MudSnackbarProvider />

<style>
    @* A startup step that is waiting to be run. The whole row is the target, so it has to look like
       one — the play button alone is a small thing to aim at, and nothing else said the row could be
       clicked (B194). Applied only while the step is actually runnable, so a step that has finished
       or one that is waiting on another does not invite a click that would do nothing. *@
    .mlqt-deferred-step {
        cursor: pointer;
    }

    .mlqt-deferred-step:hover {
        background-color: var(--mud-palette-action-default-hover);
    }

    @* MudBlazor's density - tabs, buttons, trees, icons - is MLQT.UI.Theme's mlqt-density.css. What
       stays here is this application's own. *@

    @* MLQT's window is one screen that never scrolls: the panes scroll inside it. That is a fact
       about this shell, not about the theme - on a page that scrolls, 100vw counts the scrollbar
       and the layout overflows sideways by its width - so it stays here rather than in the theme. *@
    .mud-layout {
        height: 100vh;
        width: 100vw;
        position: relative;
    }

    .mud-navmenu {
        margin: 0;
        height: 100%;
        position: relative;
        list-style: none;
        overscroll-behavior-y: contain;
    }

    /* Custom Modelica icon styles */
    .modelica-tree-icon {
        width: 20px;
        height: 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-right: 4px;
        flex-shrink: 0;
    }

    .modelica-tree-icon svg {
        width: 100%;
        height: 100%;
    }
</style>

<MudLayout>
    <MudAppBar Color="Color.Primary" Elevation="2">
        <MudText Typo="Typo.h6" Class="ml-2">MLQT - Modelica Library Quality Toolkit@(_currentProjectName != null ? $" - {_currentProjectName}" : "")</MudText>
        <MudSpacer />
        <MudTooltip Text="About MLQT and access documentation" Arrow="true" Placement="Placement.Bottom">
            <MudIconButton Icon="@Icons.Material.Outlined.Help" Color="Color.Inherit" Size="Size.Large" OnClick="() => _showAboutDialog = true" />
        </MudTooltip>
    </MudAppBar>
    <MudMainContent Style="height:calc(100vh - 4px); width:calc(100vw - 8px);">
        @* The split's proportions and each pane's minimum are in app.css (`mlqt-split`), because
           MudSplitPanel takes one minimum for both panes and an initial size only in pixels. *@
        <MudSplitPanel Class="mlqt-split mlqt-split-quarter" PanelGap="4" MinPanelSize="200"
                       ClassDivider="mlqt-split-divider"
                       ClassFirstPanel="mlqt-tree-pane pt-2 pb-2 pl-2"
                       ClassSecondPanel="mlqt-tab-host mlqt-pane-min-400 pa-2">
            <FirstPanel>
                <MudStack Row="false">
                    <MudButtonGroup Variant="Variant.Outlined" Size="Size.Medium" >
                        <MudTooltip Text="Add Repository" Arrow="true" Placement="Placement.Right">
                            <MudIconButton Icon="@Icons.Material.Filled.CreateNewFolder" Color="Color.Primary" OnClick="OpenAddRepositoryDialog" Size="Size.Medium"/>
                        </MudTooltip>
                        @if (_settings.UI.RepositoryMode) {
                            <MudTooltip Text="Library view"  Arrow="true" Placement="Placement.Right">
                                <MudIconButton Icon="@Icons.Material.Filled.LocalLibrary" Color="Color.Primary" OnClick="ToggleView" Size="Size.Medium"/>
                            </MudTooltip>
                        }
                        else
                        {
                            <MudTooltip Text="Repository view"  Arrow="true" Placement="Placement.Right">
                                <MudIconButton Icon="@Icons.Material.Filled.Archive" Color="Color.Primary" OnClick="ToggleView" Size="Size.Medium"/>
                            </MudTooltip>
                        }
                        <MudBadge Content="@_pendingChangesCount" Color="Color.Error" Origin="Origin.CenterRight"
                                 Visible="@(_pendingChangesCount > 0)" Overlap="true">
                            <MudTooltip Text="@GetRefreshTooltip()" Arrow="true" Placement="Placement.Right">
                                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                               Color="@(_pendingChangesCount > 0 ? Color.Warning : Color.Primary)"
                                               Size="Size.Medium"
                                               OnClick="RefreshLibrariesAsync"
                                               Disabled="@(_isRefreshing || NavState.IsVcsWorkInProgress)"/>
                            </MudTooltip>
                        </MudBadge>
                    </MudButtonGroup>
                    <MudExpansionPanels MultiExpansion="true" Dense="true" Gutters="false" Elevation="2">
                        @if (_settings.UI.RepositoryMode)
                        {
                            @foreach (var repo in RepositoryService.Repositories)
                            {
                                @* Keyed, so a reorder moves each browser - its filter, busy flag and
                                   expansion - with its repository rather than handing it on (B353). *@
                                <LibraryBrowser @key="repo.Id" LibraryOnly="false" Repository="@repo" />
                            }
                        }
                        else
                        {
                            <LibraryBrowser LibraryOnly="true" />
                        }
                    </MudExpansionPanels>
                </MudStack>
            </FirstPanel>
            <SecondPanel>
                @* `mlqt-tab-host` makes this pane a flex column so the tabs take the height that is
                   actually left rather than one computed from the viewport. See app.css: every page
                   in here used to subtract its own guess at the chrome above it (185px, 140px,
                   135px — three numbers for the same distance), and the Code Review page's was
                   right to within 12px, so anything that grew above it scrolled the whole page and
                   took the current-class box with it (B250). *@
                <MudStack Row="false" Style="gap:0px !important;">
                    <CurrentModelDisplay />
                    <MudTabs Outlined="true" MinimumTabWidth="50px" Rounded="true">
                        <MudTabPanel Icon="@Icons.Material.Filled.Code" ToolTip="Code Review and Findings">
                            <CodeReview />
                        </MudTabPanel>
                        <MudTabPanel Icon="@Icons.Material.Filled.AccountTree" ToolTip="View Dependencies">
                            <Dependencies />
                        </MudTabPanel>
                        <MudTabPanel Icon="@Icons.Material.Filled.FolderOpen" ToolTip="External Resources">
                            <ExternalResources />
                        </MudTabPanel>
                        <MudTabPanel Icon="@Icons.Material.Filled.BarChart" ToolTip="Metrics">
                            <MetricsDashboard />
                        </MudTabPanel>
                        <MudTabPanel Icon="@Icons.Material.Filled.Settings" ToolTip="Settings">
                            <Settings />
                        </MudTabPanel>
                    </MudTabs>                          
                </MudStack>
            </SecondPanel>
        </MudSplitPanel>
    </MudMainContent>
</MudLayout>

<ProgressDialog Visible="_startupProcessRunning">
    <TitleContent>
        <MudText Typo="Typo.h6">Loading project repositories, please wait</MudText>
    </TitleContent>
    <DialogContent>
        <MudList T="string">
            <MudListItem>
                <AvatarContent>
                    <MudProgressCircular Color="@_step1color" Indeterminate="_step1running" Value="100" Size="Size.Small" />
                </AvatarContent>
                <ChildContent>Loading libraries from repositories</ChildContent>
            </MudListItem>
            <MudListItem>
                <AvatarContent>
                    <MudProgressCircular Color="@_step2color" Indeterminate="_step2running" Value="100" Size="Size.Small" />
                </AvatarContent>
                <ChildContent>
                    <MudText Typo="Typo.body1">Formatting modified files</MudText>
                </ChildContent>
            </MudListItem>
            @* The whole row runs the step, not only the play button (B194). The button stays: it is
               what says the row is actionable at a glance, and it is the keyboard target. Both
               reach the same handler, and a click on the button bubbles to the row, so the handler
               refuses the second arrival rather than starting the work twice. *@
            <MudListItem T="string" OnClick="RunDeferredDependenciesFromDialogAsync"
                         Class="@(_step3deferred && !_runningDeferredStep ? "mlqt-deferred-step" : null)">
                <AvatarContent>
                    @if (_step3deferred)
                    {
                        <MudTooltip Text="Analyse dependencies now">
                            <MudIconButton Icon="@Icons.Material.Outlined.PlayCircle" Color="Color.Primary" Size="Size.Large" Style="padding: 0px !important"
                                OnClick="RunDeferredDependenciesFromDialogAsync" Disabled="_runningDeferredStep" />
                        </MudTooltip>
                    }
                    else
                    {
                        <MudProgressCircular Color="@_step3color" Indeterminate="_step3running" Value="100" Size="Size.Small" />
                    }
                </AvatarContent>
                <ChildContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudText Typo="Typo.body1" Style="@(_step3deferred ? "color: var(--mud-palette-text-disabled);" : "")">Analysing dependencies</MudText>
                    </MudStack>
                </ChildContent>
            </MudListItem>
            @* The whole row runs the step, not only the play button (B194). The button stays: it is
               what says the row is actionable at a glance, and it is the keyboard target. Both
               reach the same handler, and a click on the button bubbles to the row, so the handler
               refuses the second arrival rather than starting the work twice. *@
            <MudListItem T="string" OnClick="RunDeferredStyleCheckingFromDialogAsync"
                         Class="@(_step4deferred && !_runningDeferredStep ? "mlqt-deferred-step" : null)">
                <AvatarContent>
                    @if (_step4deferred)
                    {
                        <MudTooltip Text="Run style checking now">
                            <MudIconButton Icon="@Icons.Material.Outlined.PlayCircle" Color="Color.Primary" Size="Size.Large" Style="padding: 0px !important"
                                OnClick="RunDeferredStyleCheckingFromDialogAsync" Disabled="_runningDeferredStep" />
                        </MudTooltip>
                    }
                    else
                    {
                        <MudProgressCircular Color="@_step4color" Indeterminate="_step4running" Value="100" Size="Size.Small" />
                    }
                </AvatarContent>
                <ChildContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudText Typo="Typo.body1" Style="@(_step4deferred ? "color: var(--mud-palette-text-disabled);" : "")">Style checking</MudText>
                    </MudStack>
                </ChildContent>
            </MudListItem>
            @* The whole row runs the step, not only the play button (B194). The button stays: it is
               what says the row is actionable at a glance, and it is the keyboard target. Both
               reach the same handler, and a click on the button bubbles to the row, so the handler
               refuses the second arrival rather than starting the work twice. *@
            <MudListItem T="string" OnClick="RunDeferredExternalResourcesFromDialogAsync"
                         Class="@(_step5deferred && !_runningDeferredStep ? "mlqt-deferred-step" : null)">
                <AvatarContent>
                    @if (_step5deferred)
                    {
                        <MudTooltip Text="Analyse external resources now">
                            <MudIconButton Icon="@Icons.Material.Outlined.PlayCircle" Color="Color.Primary" Size="Size.Large" Style="padding: 0px !important"
                                OnClick="RunDeferredExternalResourcesFromDialogAsync" Disabled="_runningDeferredStep" />
                        </MudTooltip>
                    }
                    else
                    {
                        <MudProgressCircular Color="@_step5color" Indeterminate="_step5running" Value="100" Size="Size.Small" />
                    }
                </AvatarContent>
                <ChildContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudText Typo="Typo.body1" Style="@(_step5deferred ? "color: var(--mud-palette-text-disabled);" : "")">Analysing external resources</MudText>
                    </MudStack>
                </ChildContent>
            </MudListItem>
            <MudListItem>
                <AvatarContent>
                    <MudProgressCircular Color="@_step6color" Indeterminate="_step6running" Value="100" Size="Size.Small" />
                </AvatarContent>
                <ChildContent>Setup file system monitors</ChildContent>
            </MudListItem>
        </MudList>
        @if (_startupHadLoadWarning)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                A repository could not be loaded (see the notification) — its path may have moved or been
                deleted. Continue to the app and fix or remove it in Settings &gt; Manage Repositories.
            </MudAlert>
        }
        @if (_step3deferred || _step4deferred || _step5deferred)
        {
            <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-2">
                <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary"
                           OnClick="RunAllDeferredFromDialogAsync" Disabled="_runningDeferredStep">Run All</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Default" Disabled="_runningDeferredStep"
                           OnClick="CloseStartupDialog">Close</MudButton>
            </MudStack>
        }
        else if (_startupHadLoadWarning)
        {
            <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-2">
                <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary"
                           OnClick="CloseStartupDialog">Continue to app</MudButton>
            </MudStack>
        }
    </DialogContent>
</ProgressDialog>

@* A startup begun before the window was reloaded, and still running on the services that survived
   it (B407), or a project switch in the same position (B423). This instance skipped startup
   (B270), so the step is all it has to show. *@
<ProgressDialog Visible="EarlierStartupVisible" Options="_nonClosableDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Loading project repositories, please wait</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-4">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1" Class="mt-4">@NavState.StartupStep</MudText>
        </MudStack>
    </DialogContent>
</ProgressDialog>

<ProgressDialog Visible="_fullFormatRunning" Options="_nonClosableDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Formatting all files</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-4">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1" Class="mt-4">@_fullFormatStatusMessage</MudText>
        </MudStack>
    </DialogContent>
</ProgressDialog>

<ProgressDialog Visible="_styleCheckRunning" Options="_nonClosableDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Running style checking</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-4">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1" Class="mt-4">@_styleCheckStatusMessage</MudText>
        </MudStack>
    </DialogContent>
</ProgressDialog>

<MudDialog @bind-Visible="_showAboutDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">About MLQT</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Row="false" Spacing="2">
            <MudText Typo="Typo.subtitle1">Version @version</MudText>
            <MudButton StartIcon="@Icons.Custom.Brands.GitHub" Size="Size.Small" Color="Color.Primary" 
                Variant="Variant.Outlined" OnClick="OpenGitHub">Goto Github project</MudButton>
            <MudButton StartIcon="@Icons.Custom.Brands.GitHub" Size="Size.Small" Color="Color.Primary" 
                Variant="Variant.Outlined" OnClick="OpenDocumentation">Goto user documentation</MudButton>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.Outlined.Close" Size="Size.Small" Color="Color.Primary" 
            Variant="Variant.Outlined" OnClick="()=>_showAboutDialog=false">Close</MudButton>
    </DialogActions>
</MudDialog>
