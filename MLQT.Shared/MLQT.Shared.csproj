    <PackageReference Include="NLog" Version="6.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DymolaInterface\DymolaInterface.csproj" />
    <ProjectReference Include="..\MLQT.Services\MLQT.Services.csproj" />
    <ProjectReference Include="..\ModelicaParser\ModelicaParser.csproj" />
    <ProjectReference Include="..\ModelicaGraph\ModelicaGraph.csproj" />
    <ProjectReference Include="..\OpenModelicaInterface\OpenModelicaInterface.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Dialogs\" />
  </ItemGroup>

</Project>