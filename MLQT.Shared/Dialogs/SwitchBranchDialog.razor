@using MLQT.Services.Interfaces
@using MLQT.Shared.Components


<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Switch Branch</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Style="min-width: 400px;">
            @if (_hasChanges)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    You have uncommitted changes. These may be affected by switching branches.
                </MudAlert>
            }

            <MudText Typo="Typo.body1">Select a branch or tag to switch to:</MudText>

            <BranchSelector RepositoryId="@RepositoryId"
                            @bind-SelectedBranch="_selectedBranch"
                            @bind-SelectedIsTag="_selectedIsTag"
                            ExcludeCurrentBranch="true"
                            IncludeRemoteBranches="true"
                            MinHeight="300px"
                            MaxHeight="400px" />

            @* Said before the switch, not after it. A tag is a place in history, not a branch: git
               leaves HEAD detached there, and a commit made in that state belongs to nothing and is
               easy to lose. Other clients warn about it and MLQT offered no tags at all (B193). *@
            @if (_selectedIsTag)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    <strong>@_selectedBranch</strong> is a tag. Switching to it puts the repository at
                    that exact revision with no branch checked out (a detached HEAD), which is what
                    you want for looking at a released version. To make changes from here, create a
                    branch afterwards.
                </MudAlert>
            }

            @if (_isSwitching && !string.IsNullOrEmpty(_statusMessage))
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <MudText Typo="Typo.body1">@_statusMessage</MudText>
                    </MudStack>
                </MudAlert>
            }

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_errorMessage</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="SwitchBranch" Disabled="@(string.IsNullOrEmpty(_selectedBranch) || _isSwitching)">
            @if (_isSwitching)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Switch
        </MudButton>
    </DialogActions>
</MudDialog>
