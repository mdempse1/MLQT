<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Select Project</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body1" Class="mb-2">
            Select which project to load:
        </MudText>
        <MudRadioGroup T="string" @bind-Value="_selectedProject">
            <MudStack Row="false" Spacing="0">
                @foreach (var project in _projects)
                {
                    @* The row loads the project, not only the radio plus the button (B194). The
                       button stays: it is what makes the keyboard path work, since arrowing through
                       a radio group moves the selection without committing it. *@
                    <div class="project-row" @onclick="@(() => SelectAndLoad(project.Id))">
                        <MudRadio Dense="true" T="string" Value="@project.Id" Size="Size.Small" Color="Color.Primary">
                            @($"{project.Name} ({project.Repositories.Count} repositories)")
                        </MudRadio>
                    </div>
                }
            </MudStack>
        </MudRadioGroup>
        @if (_showNewProjectControls)
        {
            <MudTextField @bind-Value="_selectedProject" Label="Create a new project"
                Variant="Variant.Outlined" Margin="Margin.Dense" Typo="Typo.body1"
                Immediate="true" Style="max-width: 400px;" />
            <MudIconButton Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success"
                OnClick="ConfirmProjectName" Disabled="@(string.IsNullOrWhiteSpace(_selectedProject))" />
            <MudIconButton Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error"
                OnClick="()=>{_showNewProjectControls=false; _selectedProject=string.Empty;}" />
        }
        </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" OnClick="()=>{_showNewProjectControls=true; _selectedProject=string.Empty;}">
            New Project
        </MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small"
            OnClick="Select" Disabled="@(string.IsNullOrEmpty(_selectedProject))">
            Load Project
        </MudButton>
    </DialogActions>
</MudDialog>
