@using MLQT.Services.Interfaces



<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Add Repository</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Style="min-width: 400px;">
            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-6" 
                ActivePanelIndex="@_activeIndex" ActivePanelIndexChanged="@OnTabChanged">
                <MudTabPanel Text="Select Local Directory">
                    <MudText Typo="Typo.body1">Select a directory containing Modelica libraries to use as a repository</MudText>
                    <MudTextField @bind-Value="_path"
                                Label="Repository Path"
                                Typo="Typo.body1" Margin="Margin.Dense"
                                Variant="Variant.Outlined"
                                Adornment="Adornment.End"
                                AdornmentIcon="@Icons.Material.Filled.FolderOpen"
                                OnAdornmentClick="BrowseForFolder"
                                HelperText="Enter a local path or click the folder icon to browse"
                                Immediate="true" />
                    @if (_detectedVcsType != null)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                @switch (_detectedVcsType.Value)
                                {
                                    case RepositoryVcsType.Git:
                                        <MudText>Git repository detected</MudText>
                                        break;
                                    case RepositoryVcsType.SVN:
                                        <MudText>SVN repository detected</MudText>
                                        break;
                                    case RepositoryVcsType.Local:
                                        <MudText>Local directory (no VCS)</MudText>
                                        break;
                                }
                            </MudStack>
                        </MudAlert>
                    }
                    @if (_detectedVcsRoot != null)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            <MudText>This path is within a repository rooted at <strong>@_detectedVcsRoot</strong>.
                            Branch, merge, commit and other VCS operations will apply to the full repository.</MudText>
                        </MudAlert>
                    }
                </MudTabPanel>
                <MudTabPanel Text="Download Remote Repository">
                    <MudText Typo="Typo.body1">Enter the URL to download the repository from</MudText>
                    <MudTextField @bind-Value="_url"
                                Label="Remote Repository Address"
                                Typo="Typo.body1" Margin="Margin.Dense"
                                Variant="Variant.Outlined"
                                HelperText="Enter the remote address to download the repository from.  Supports Git and SVN"
                                Immediate="true"
                                DebounceInterval="300"
                                TextChanged="OnURLChanged" />
                    <MudTextField @bind-Value="_checkoutPath"
                                Label="Checkout Directory"
                                Typo="Typo.body1" Margin="Margin.Dense"
                                Variant="Variant.Outlined"
                                Adornment="Adornment.End"
                                AdornmentIcon="@Icons.Material.Filled.FolderOpen"
                                OnAdornmentClick="BrowseForCheckoutFolder"
                                HelperText="Select where to checkout the repository on the local machine" />
                    @if (_detectedVcsType != null)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                @switch (_detectedVcsType.Value)
                                {
                                    case RepositoryVcsType.Git:
                                        <MudIcon Icon="@Icons.Custom.Brands.GitHub" Size="Size.Small" />
                                        <MudText>Git repository detected</MudText>
                                        break;
                                    case RepositoryVcsType.SVN:
                                        <MudIcon Icon="@Icons.Material.Filled.Source" Size="Size.Small" />
                                        <MudText>SVN repository detected</MudText>
                                        break;
                                    case RepositoryVcsType.Local:
                                        <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" />
                                        <MudText>Local directory (no VCS)</MudText>
                                        break;
                                }
                            </MudStack>
                        </MudAlert>
                    }
                </MudTabPanel>
            </MudTabs>

            <MudCheckBox @bind-Value="_isReferenceOnly" Dense="true" Size="Size.Small" Color="Color.Primary">
                <MudText Typo="Typo.body1">Reference only — I do not maintain this code</MudText>
            </MudCheckBox>
            <MudText Typo="Typo.caption" Class="ml-8 mt-n2">
                Loaded so that references into it resolve. It is not style-checked, does not count
                towards coverage, and nothing is written into it — no <code>.mlqt</code> directory.
                @if (_readOnlyOnDisk)
                {
                    <text><b>This folder cannot be written to, so it has been ticked for you.</b></text>
                }
            </MudText>

            @if (_isLoading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                <MudText Typo="Typo.caption">@_loadingMessage</MudText>
            }

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_errorMessage</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="NextStep" Disabled="@(!CanProceed || _isLoading)">Add Repository</MudButton>
    </DialogActions>
</MudDialog>
