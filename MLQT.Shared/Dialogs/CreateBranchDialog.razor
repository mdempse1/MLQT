@using MLQT.Services.Interfaces
@using RevisionControl


<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Create New Branch</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Style="min-width: 400px;">
            @if (_isLoading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else
            {
                <MudText Typo="Typo.body1">
                    Create a new branch from the current state of <strong>@(_currentBranch ?? "HEAD")</strong>.
                </MudText>

                <MudTextField @bind-Value="_branchName"
                              Label="Branch Name"
                              Placeholder="branches/my-new-feature"
                              Variant="Variant.Outlined"                              
                              Typo="Typo.body1"
                              Required="true"
                              RequiredError="Branch name is required"
                              HelperText="Enter a name for the new branch"
                              Immediate="true"
                              TextChanged="OnBranchNameChanged" />

                @if (_branchExists)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">
                        A branch with this name already exists.
                    </MudAlert>
                }

                <MudCheckBox @bind-Value="_switchToBranch" Label="Switch to new branch after creation" Color="Color.Primary" />
            }

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_errorMessage</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Size="Size.Small" Variant="Variant.Outlined">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small"
                   OnClick="CreateBranch" Disabled="@(!CanCreate || _isCreating)">
            @if (_isCreating)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Create Branch
        </MudButton>
    </DialogActions>
</MudDialog>
