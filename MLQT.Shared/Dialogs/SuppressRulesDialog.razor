@using MLQT.Services.Checking

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Suppress rules in @ClassName</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="1" Style="min-width: 520px; max-width: 720px;">
            <MudText Typo="Typo.caption">
                Applies to <strong>@ClassId</strong> and every class nested in it. Written into its
                source as <code>__MLQT(suppress=…)</code>, so the desktop app, <code>mlqt check</code>
                and the MCP server all honour it.
            </MudText>

            @foreach (var note in EnclosingNotes)
            {
                <MudText Typo="Typo.caption" Class="mlqt-suppress-enclosing">@note</MudText>
            }

            <MudStack Row="true" Spacing="0" AlignItems="AlignItems.Center">
                <MudSwitch T="bool" Value="_everyRule" ValueChanged="SetEveryRule" Color="Color.Warning" Size="Size.Small"
                           Label="All rules (*)" Class="mlqt-suppress-all" />
                <MudSpacer />
                <MudSwitch T="bool" Value="_showAllRules" ValueChanged="SetShowAllRules" Color="Color.Primary" Size="Size.Small"
                           Label="Show every rule" Class="mlqt-suppress-show-all" />
            </MudStack>

            @if (_everyRule)
            {
                <MudText Typo="Typo.caption">
                    Every rule is suppressed while this is on. The rules ticked below are kept, so turning
                    it off again leaves them suppressed.
                </MudText>
            }

            @if (_choices.Count == 0)
            {
                <MudText Typo="Typo.body1" Class="mlqt-suppress-none">
                    No findings in this class or the classes nested in it. Turn on <em>Show every rule</em>
                    to choose from all of them.
                </MudText>
            }
            else
            {
                <div class="mlqt-suppress-rules" style="max-height: 50vh; overflow-y: auto;">
                    @{ string? category = null; }
                    @foreach (var choice in _choices)
                    {
                        if (choice.Category != category)
                        {
                            category = choice.Category;
                            <MudText Typo="Typo.subtitle2" Class="mt-1">@category</MudText>
                        }
                        <MudStack Row="true" Spacing="0" AlignItems="AlignItems.Center" Class="mlqt-suppress-rule">
                            <MudCheckBox T="bool" Value="@_ticked.Contains(choice.Id)" ValueChanged="@(on => SetTicked(choice.Id, on))"
                                         Size="Size.Small" Dense="true" Color="Color.Primary" />
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.body1">@choice.Title</MudText>
                                <MudText Typo="Typo.caption">@choice.Id</MudText>
                            </MudStack>
                            <MudSpacer />
                            @if (choice.Findings > 0)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@FindingsLabel(choice.Findings)</MudChip>
                            }
                        </MudStack>
                    }
                </div>
            }

            <MudTextField @bind-Value="_reason" Label="Reason" Placeholder="Generated by Dymola's FMU import"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Typo="Typo.body1"
                          HelperText="Recorded beside the list, so a reviewer can see why." />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Size="Size.Small" Variant="Variant.Outlined">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" OnClick="Save"
                   Class="mlqt-suppress-save">Save</MudButton>
    </DialogActions>
</MudDialog>
