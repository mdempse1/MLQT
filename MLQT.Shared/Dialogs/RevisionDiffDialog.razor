@using ModelicaParser.Helpers
@using MLQT.Services.Interfaces
@using RevisionControl
@using System.IO


<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.Difference" Size="Size.Small" />
            <MudText Typo="Typo.h6">Diff: @Path.GetFileName(FilePath) @@ @ShortRevision</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (_isLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_errorMessage != null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true">@_errorMessage</MudAlert>
        }
        else if (_originalContent == _modifiedContent)
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                File is identical between revision @ShortRevision and the working copy.
            </MudAlert>
        }
        else
        {
            <DiffViewer OriginalContent="@(_originalContent ?? string.Empty)"
                        ModifiedContent="@(_modifiedContent ?? string.Empty)"
                        FileName="@FilePath"
                        OriginalLabel="@($"Revision {ShortRevision}")"
                        ModifiedLabel="Working Copy"
                        ViewMode="DiffViewMode.Unified"
                        ShowViewModeSelectorButtons="true"
                        Height="60vh" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog?.Close())">Close</MudButton>
    </DialogActions>
</MudDialog>
