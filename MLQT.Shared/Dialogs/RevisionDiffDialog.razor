@using ModelicaParser.Helpers
@using MLQT.Services.Interfaces
@using RevisionControl
@using System.IO


<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.Difference" Size="Size.Small" />
            <MudText Typo="Typo.h6">Diff: @Path.GetFileName(FilePath) @@ @ShortRevision</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (_isLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_errorMessage != null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true">@_errorMessage</MudAlert>
        }
        else if (_originalContent == _modifiedContent)
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                Revision @ShortRevision did not change this file.
            </MudAlert>
        }
        else
        {
            @* What the commit changed: the revision before it on the left, the revision itself on
               the right. It used to put the working copy on the right, which against an old commit
               is mostly other people's later work (B202). *@
            <DiffViewer OriginalContent="@(_originalContent ?? string.Empty)"
                        ModifiedContent="@(_modifiedContent ?? string.Empty)"
                        FileName="@FilePath"
                        OriginalLabel="@PreviousLabel"
                        ModifiedLabel="@($"Revision {ShortRevision}")"
                        ViewMode="DiffViewMode.Unified"
                        ShowViewModeSelectorButtons="true"
                        Height="60vh" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog?.Close())">Close</MudButton>
    </DialogActions>
</MudDialog>
