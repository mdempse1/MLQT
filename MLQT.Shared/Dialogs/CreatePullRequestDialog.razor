@using MLQT.Services.Interfaces
@using MLQT.Shared.Components


<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Create Pull Request</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2" Style="min-width: 480px;">

            @* ── Checking phase ── *@
            @if (_phase == PrPhase.Checking)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else
            {
                @* Branch summary *@
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudText Typo="Typo.body1">
                        Merge <strong>@_currentBranch</strong> into:
                    </MudText>
                </MudStack>

                @* Base branch selector *@
                <BranchSelector RepositoryId="@RepositoryId"
                                @bind-SelectedBranch="_selectedBaseBranch"
                                ExcludeCurrentBranch="true"
                                IncludeRemoteBranches="false"
                                MinHeight="120px"
                                MaxHeight="200px" />

                @* Push status indicator *@
                @if (_phase == PrPhase.NeedsPush)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Icon="@Icons.Material.Filled.CloudUpload">
                        Branch has not been pushed to remote yet. It will be pushed before opening the pull request.
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Success" Dense="true" Icon="@Icons.Material.Filled.CloudDone">
                        Branch is up to date on remote.
                    </MudAlert>
                }

                @* Working indicator *@
                @if (_isWorking && !string.IsNullOrEmpty(_statusMessage))
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            <MudText Typo="Typo.body1">@_statusMessage</MudText>
                        </MudStack>
                    </MudAlert>
                }

                @* Error message *@
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_errorMessage</MudAlert>
                }
            }

        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_isWorking">Cancel</MudButton>

        @if (_phase == PrPhase.NeedsPush)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                       Disabled="_isWorking || string.IsNullOrEmpty(_selectedBaseBranch)"
                       OnClick="OpenPullRequest">
                @if (_isWorking)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                }
                Push and Create Pull Request
            </MudButton>
        }
        else if (_phase == PrPhase.Ready)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                       Disabled="_isWorking || string.IsNullOrEmpty(_selectedBaseBranch)"
                       OnClick="OpenPullRequest">
                Create Pull Request
            </MudButton>
        }
    </DialogActions>
</MudDialog>
