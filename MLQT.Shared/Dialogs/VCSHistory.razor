@using MLQT.Services.Interfaces
@using RevisionControl
@using System.Runtime.CompilerServices


<MudDialog Style="min-width: 800px;">
    <TitleContent>
        <MudText Typo="Typo.h6">
            @if (_repository != null)
            {
                <span>VCS History - @_repository.Name (@_repository.VcsType)</span>
            }
            else
            {
                <span>VCS History</span>
            }
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_repository == null)
        {
            <MudAlert Severity="Severity.Warning">Repository not found.</MudAlert>
        }
        else if (_repository.VcsType == RepositoryVcsType.Local)
        {
            <MudAlert Severity="Severity.Info">This is a local directory without version control.</MudAlert>
        }
        else
        {
            <MudStack Spacing="2">
                <!-- Date Range Filter -->
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudDatePicker Label="From" @bind-Date="_fromDate" Clearable="true" Margin="Margin.Dense" IconSize="Size.Small" />
                    <MudDatePicker Label="To" @bind-Date="_toDate" Clearable="true"  Margin="Margin.Dense" IconSize="Size.Small"  />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyDateFilter" Size="Size.Small" >Apply</MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="ResetDateFilter" Size="Size.Small">Reset</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadMore" Size="Size.Small"
                               Disabled="@(_isLoading || _logEntries.Count >= _currentOptions.MaxEntries)">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Load Next 50
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="LoadAll" Disabled="@_isLoading" Size="Size.Small">
                        Load Last 500
                    </MudButton>
                </MudStack>

                <!-- Log Table -->
                <MudTable T="VcsLogEntry" Items="@_logEntries" Dense="true" Hover="true"
                          FixedHeader="true" Height="400px"
                          SelectedItem="_selectedEntry" SelectedItemChanged="OnSelectedEntryChanged"
                          RowClassFunc="GetRowClass"
                          OnRowClick="OnRowClick">
                    <HeaderContent>
                        @if (_graphWidth > 0)
                        {
                            <MudTh Style="@($"width: {_graphWidth}px; padding: 0; min-width: {_graphWidth}px;")"></MudTh>
                        }
                        <MudTh Style="width: 70px;">Revision</MudTh>
                        <MudTh Style="width: 100px;">Branch</MudTh>
                        <MudTh Style="width: 140px;">Author</MudTh>
                        <MudTh Style="width: 150px;">Date</MudTh>
                        <MudTh>Message</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        @{
                            var isCurrentRevision = IsCurrentRevision(context);
                        }
                        @if (_graphWidth > 0)
                        {
                            <MudTd Style="padding: 0; line-height: 0; vertical-align: middle;">
                                <svg width="@_graphWidth" height="@GraphRowHeight" style="display:block; overflow:visible;">
                                    @((MarkupString)(_graphRowByRevision.TryGetValue(context.Revision, out var gr) ? gr.SvgPaths : ""))
                                </svg>
                            </MudTd>
                        }
                        <MudTd DataLabel="Revision" Style="@(isCurrentRevision ? "font-weight: bold;min-width: 70px;" : "min-width: 70px;")" Class="body1-table-right">
                            <MudTooltip Text="@GetRevisionTooltip(context)">
                                @context.ShortRevision
                            </MudTooltip>
                        </MudTd>
                        <MudTd DataLabel="Branch" Style="@(isCurrentRevision ? "font-weight: bold;min-width: 100px;max-width: 100px;white-space: nowrap;overflow: hidden;text-overflow: ellipsis;" : "min-width: 100px;max-width: 100px;white-space: nowrap;overflow: hidden;text-overflow: ellipsis;")" Class="body1-table">
                            <MudTooltip Text="@(context.Branch ?? "")">
                                @(context.Branch ?? "-")
                            </MudTooltip>
                        </MudTd>
                        <MudTd DataLabel="Author" Style="@(isCurrentRevision ? "font-weight: bold;min-width: 140px;max-width: 140px;white-space: nowrap;overflow: hidden;text-overflow: ellipsis;" : "min-width: 140px;max-width: 140px;white-space: nowrap;overflow: hidden;text-overflow: ellipsis;")" Class="body1-table">
                            <MudTooltip Text="@context.AuthorEmail" Disabled="@string.IsNullOrEmpty(context.AuthorEmail)">
                                @context.Author
                            </MudTooltip>
                        </MudTd>
                        <MudTd DataLabel="Date" Style="@(isCurrentRevision ? "font-weight: bold;min-width: 150px;" : "min-width: 150px;")" Class="body1-table">
                            @context.Date.ToString("dd-MMM-yyyy HH:mm")
                        </MudTd>
                        <MudTd DataLabel="Message" Style="@(isCurrentRevision ? "font-weight: bold; max-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" : "max-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;")" Class="body1-table">
                            <MudTooltip Text="@(context.Message == context.MessageShort ? context.MessageShort : context.Message)">
                                @context.MessageShort
                            </MudTooltip>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText>No log entries found.</MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudStack>
            <!-- Changed Files Popover -->
            <MudPopover Open="@_showChangedFiles" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.BottomRight" Class="pa-4" Style="max-height: 400px; overflow-y: auto;">
                <MudStack Spacing="2">
                    <MudStack Row="true">
                        <MudText Typo="Typo.subtitle2">@_changedFilesRevision changed Files (@_changedFiles.Count)</MudText>
                        <MudSpacer />
                        @if (!_confirmingCheckout && !_isCheckingOut)
                        {
                            <MudTooltip Text="Checkout this revision">
                                <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small" OnClick="CheckoutRevision" />
                            </MudTooltip>
                        }
                        <MudTooltip Text="Close this window">
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseChangedFilesPopover" />
                        </MudTooltip>
                    </MudStack>
                    <MudDivider />
                    @if (_confirmingCheckout)
                    {
                        <MudStack Spacing="2">
                            <MudAlert Severity="Severity.Warning" Dense="true">
                                Checkout revision <strong>@_selectedEntry?.ShortRevision</strong>?
                                Any uncommitted changes will be lost.
                            </MudAlert>
                            <MudStack Row="true" Spacing="2">
                                <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" OnClick="ConfirmCheckoutAsync">Checkout</MudButton>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="CancelCheckout">Cancel</MudButton>
                            </MudStack>
                        </MudStack>
                    }
                    else if (_isCheckingOut)
                    {
                        <MudStack Spacing="1" AlignItems="AlignItems.Center" Row="true">
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            <MudText Typo="Typo.body1">Checking out revision @_selectedEntry?.ShortRevision…</MudText>
                        </MudStack>
                    }
                    else if (_checkoutResultMessage != null)
                    {
                        <MudAlert Severity="@(_checkoutResultSuccess ? Severity.Success : Severity.Error)" Dense="true">
                            @_checkoutResultMessage
                        </MudAlert>
                    }
                    else if (_isLoadingChangedFiles)
                    {
                        <MudProgressLinear Indeterminate="true" />
                    }
                    else if (_changedFiles.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No changed files found.</MudText>
                    }
                    else
                    {
                        <MudList T="VcsChangedFile" Dense="true">
                            @foreach (var file in _changedFiles)
                            {
                                <MudListItem T="VcsChangedFile" Dense="true" OnClick="@(() => ShowFileDiffAsync(file))">
                                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                        @switch (file.ChangeType)
                                        {
                                            case VcsChangeType.Added:
                                                <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Success" />
                                                break;
                                            case VcsChangeType.Deleted:
                                                <MudIcon Icon="@Icons.Material.Filled.Remove" Size="Size.Small" Color="Color.Error" />
                                                break;
                                            case VcsChangeType.Modified:
                                                <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Warning" />
                                                break;
                                            case VcsChangeType.Renamed:
                                                <MudIcon Icon="@Icons.Material.Filled.DriveFileRenameOutline" Size="Size.Small" Color="Color.Info" />
                                                break;
                                            case VcsChangeType.Copied:
                                                <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Color="Color.Info" />
                                                break;
                                        }
                                        <MudText Typo="Typo.body1">
                                            @file.Path
                                            @if (!string.IsNullOrEmpty(file.OldPath))
                                            {
                                                <span style="color: var(--mud-palette-text-secondary);"> (from @file.OldPath)</span>
                                            }
                                        </MudText>
                                    </MudStack>
                                </MudListItem>
                            }
                        </MudList>
                    }
                </MudStack>
            </MudPopover>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .current-revision-row {
        background-color: #cccccc !important;
    }
    .current-revision-row:hover {
        background-color: var(--mud-palette-primary-hover) !important;
    }
    .popover-source-row {
        background-color: var(--mud-palette-primary-hover) !important;
        box-shadow: inset 3px 0 0 var(--mud-palette-primary);
    }
    .popover-source-row:hover {
        background-color: var(--mud-palette-primary-hover) !important;
    }
</style>
