@using MLQT.Services
@using MLQT.Services.Interfaces
@using RevisionControl
@using RevisionControl.Interfaces
@using System.IO
@using MLQT.Shared.Components


<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Rebase Branch</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2" Style="min-width: 500px; max-width: 700px;">

            @* ── Branch selector (visible while selecting or checking) ── *@
            @if (_phase is RebasePhase.CheckingState or RebasePhase.DirtyWorkingCopy or RebasePhase.ReadyToRebase)
            {
                <MudText Typo="Typo.body1">
                    Rebase <strong>@_currentBranch</strong> onto:
                </MudText>

                <BranchSelector @ref="_branchSelector"
                                RepositoryId="@RepositoryId"
                                @bind-SelectedBranch="_selectedBranch"
                                ExcludeCurrentBranch="true"
                                IncludeRemoteBranches="true"
                                MinHeight="200px"
                                MaxHeight="280px" />
            }

            @* ── Checking state ── *@
            @if (_phase == RebasePhase.CheckingState)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }

            @* ── Dirty working copy ── *@
            @if (_phase == RebasePhase.DirtyWorkingCopy)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    The working copy has uncommitted changes. Commit or revert them before rebasing.
                    @if (_repository?.RelativeLibraryPath != null)
                    {
                        <text> Note: "Revert All" will discard all changes in <strong>@_repository.VcsRootPath</strong>, including files outside the Modelica directory.</text>
                    }
                </MudAlert>

                <MudPaper Outlined="true" Style="max-height: 180px; overflow-y: auto;">
                    <MudList T="VcsWorkingCopyFile" Dense="true">
                        @foreach (var f in _dirtyFiles)
                        {
                            <MudListItem T="VcsWorkingCopyFile" Dense="true"
                                         Icon="@StatusIcon(f.Status)"
                                         IconColor="@StatusColor(f.Status)">
                                <MudText Typo="Typo.body2">@f.Path</MudText>
                            </MudListItem>
                        }
                    </MudList>
                </MudPaper>
            }

            @* ── Rebasing progress ── *@
            @if (_phase == RebasePhase.Rebasing)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <MudText Typo="Typo.body1">Rebasing onto @_selectedBranch...</MudText>
                    </MudStack>
                </MudAlert>
            }

            @* ── Conflict resolution ── *@
            @if (_phase == RebasePhase.ConflictResolution)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    @_conflictStates.Count(kv => kv.Value == ConflictFileState.Resolved) of @_conflictStates.Count conflict(s) resolved.
                    Resolve all conflicts before continuing the rebase.
                </MudAlert>

                <MudPaper Outlined="true" Style="max-height: 340px; overflow-y: auto;">
                    <MudList T="string" Dense="true">
                        @foreach (var (filePath, state) in _conflictStates)
                        {
                            var fp = filePath;
                            var relPath = GetRelativePath(fp);

                            <MudListItem T="string" Dense="true">
                                <MudStack Spacing="0">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        @if (state == ConflictFileState.Resolved)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                                     Color="Color.Success" Size="Size.Small" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Warning"
                                                     Color="Color.Warning" Size="Size.Small" />
                                        }
                                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                                   Style="flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; justify-content:flex-start; text-transform:none; font-size:0.775rem; min-width:0; padding:0 4px;"
                                                   OnClick="@(() => ShowDiff(fp))">
                                            @relPath
                                        </MudButton>
                                    </MudStack>

                                    @if (state == ConflictFileState.Unresolved)
                                    {
                                        <MudStack Row="true" Spacing="1" Class="ml-5">
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                                       Color="Color.Primary"
                                                       Disabled="_isWorking"
                                                       OnClick="@(() => ResolveFile(fp, ConflictResolutionChoice.AcceptIncoming))">
                                                Accept Incoming
                                            </MudButton>
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                                       Disabled="_isWorking"
                                                       OnClick="@(() => ResolveFile(fp, ConflictResolutionChoice.KeepMine))">
                                                Keep Mine
                                            </MudButton>
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                                       Color="Color.Secondary"
                                                       Disabled="_isWorking"
                                                       OnClick="@(() => SetEditingExternally(fp))">
                                                Edit Externally
                                            </MudButton>
                                        </MudStack>
                                    }
                                    else if (state == ConflictFileState.EditingExternally)
                                    {
                                        <MudStack Spacing="1" Class="ml-5">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Style="word-break:break-all;">
                                                @fp
                                            </MudText>
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                                       Color="Color.Success"
                                                       Disabled="_isWorking"
                                                       OnClick="@(() => ResolveFile(fp, ConflictResolutionChoice.MarkResolved))">
                                                Mark as Resolved
                                            </MudButton>
                                        </MudStack>
                                    }
                                </MudStack>
                            </MudListItem>

                            @if (filePath != _conflictStates.Keys.Last())
                            {
                                <MudDivider />
                            }
                        }
                    </MudList>
                </MudPaper>
            }

            @* ── Push prompt ── *@
            @if (_phase == RebasePhase.PushPrompt)
            {
                <MudAlert Severity="Severity.Success" Dense="true">
                    Rebase complete. Push changes to remote?
                </MudAlert>
                <MudAlert Severity="Severity.Info" Dense="true">
                    Because rebase rewrites history, a force push is required if this branch was previously pushed.
                </MudAlert>
                @if (_pushResult?.Success == false && !string.IsNullOrEmpty(_pushResult.ErrorMessage))
                {
                    <MudAlert Severity="Severity.Error" Dense="true">Push failed: @_pushResult.ErrorMessage</MudAlert>
                }
            }

            @* ── Error message ── *@
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_errorMessage</MudAlert>
            }

        </MudStack>
    </DialogContent>
    <DialogActions>
        @if (_phase != MudDialogPhase.PushPrompt)
        {
            <MudButton OnClick="Cancel" Disabled="_phase == RebasePhase.Rebasing || _isWorking">
                Cancel
            </MudButton>
        }

        @if (_phase == RebasePhase.DirtyWorkingCopy)
        {
            <MudButton Color="Color.Default" Variant="Variant.Outlined"
                       Disabled="_isWorking"
                       OnClick="CommitFirst">
                @if (_isWorking) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> }
                Commit Changes
            </MudButton>
            <MudButton Color="Color.Warning" Variant="Variant.Filled"
                       Disabled="_isWorking"
                       OnClick="RevertAll">
                @if (_isWorking) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> }
                Revert All
            </MudButton>
        }

        @if (_phase == RebasePhase.ReadyToRebase)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                       Disabled="string.IsNullOrEmpty(_selectedBranch)"
                       OnClick="StartRebase">
                Rebase
            </MudButton>
        }

        @if (_phase == RebasePhase.ConflictResolution)
        {
            <MudButton Color="Color.Error" Variant="Variant.Outlined"
                       Disabled="_isWorking"
                       OnClick="AbortRebase">
                Abort Rebase
            </MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                       Disabled="_isWorking || !AllResolved"
                       OnClick="ContinueRebase">
                @if (_isWorking) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> }
                Continue Rebase
            </MudButton>
        }

        @if (_phase == RebasePhase.PushPrompt)
        {
            <MudButton Color="Color.Default" Variant="Variant.Outlined"
                       Disabled="_isWorking"
                       OnClick="SkipPush">
                Skip
            </MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                       Disabled="_isWorking"
                       OnClick="ForcePushToRemote">
                @if (_isWorking) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> }
                Force Push
            </MudButton>
        }
    </DialogActions>
</MudDialog>
