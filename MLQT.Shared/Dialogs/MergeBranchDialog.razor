@using MLQT.Services
@using MLQT.Services.Interfaces
@using RevisionControl
@using RevisionControl.Interfaces
@using System.IO
@using MLQT.Shared.Components


<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Merge Branch</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2" Style="min-width: 500px; max-width: 700px;">

            @* ── Branch selector (visible while selecting or checking) ── *@
            @if (_phase is MergePhase.CheckingState or MergePhase.DirtyWorkingCopy or MergePhase.ReadyToMerge)
            {
                <MudText Typo="Typo.body1">
                    Select a branch to merge into <strong>@_currentBranch</strong>:
                </MudText>

                <BranchSelector @ref="_branchSelector"
                                RepositoryId="@RepositoryId"
                                @bind-SelectedBranch="_selectedBranch"
                                ExcludeCurrentBranch="true"
                                IncludeRemoteBranches="false"
                                MinHeight="200px"
                                MaxHeight="280px" />
            }

            @* ── Checking state ── *@
            @if (_phase == MergePhase.CheckingState)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }

            @* ── Dirty working copy ── *@
            @if (_phase == MergePhase.DirtyWorkingCopy)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    The working copy has uncommitted changes. Commit or revert them before merging.
                    @if (_repository?.RelativeLibraryPath != null)
                    {
                        <text> Note: "Revert All" will discard all changes in <strong>@_repository.VcsRootPath</strong>, including files outside the Modelica directory.</text>
                    }
                </MudAlert>

                <MudPaper Outlined="true" Style="max-height: 180px; overflow-y: auto;">
                    <MudList T="VcsWorkingCopyFile" Dense="true">
                        @foreach (var f in _dirtyFiles)
                        {
                            <MudListItem T="VcsWorkingCopyFile" Dense="true"
                                         Icon="@VcsStatusHelper.GetStatusIcon(f.Status)"
                                         IconColor="@VcsStatusHelper.GetStatusColor(f.Status)">
                                <MudText Typo="Typo.body2">@f.Path</MudText>
                            </MudListItem>
                        }
                    </MudList>
                </MudPaper>
            }

            @* ── Merging progress ── *@
            @if (_phase == MergePhase.Merging)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <MudText Typo="Typo.body1">@_statusMessage</MudText>
                    </MudStack>
                </MudAlert>
            }

            @* ── Conflict resolution ── *@
            @if (_phase == MergePhase.ConflictResolution)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    @_conflictStates.Count(kv => kv.Value == ConflictFileState.Resolved) of @_conflictStates.Count conflict(s) resolved.
                    Resolve all conflicts before committing.
                </MudAlert>

                <MudPaper Outlined="true" Style="max-height: 340px; overflow-y: auto;">
                    <MudList T="string" Dense="true">
                        @foreach (var (filePath, state) in _conflictStates)
                        {
                            var fp = filePath;   @* capture for lambda *@
                            var relPath = GetRelativePath(fp);

                            <MudListItem T="string" Dense="true">
                                <MudStack Spacing="0">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        @if (state == ConflictFileState.Resolved)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                                     Color="Color.Success" Size="Size.Small" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Warning"
                                                     Color="Color.Warning" Size="Size.Small" />
                                        }
                                        @if (!_treeConflictPaths.Contains(fp))
                                        {
                                            <MudButton Variant="Variant.Text" Size="Size.Small"
                                                       Style="flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; justify-content:flex-start; text-transform:none; font-size:0.775rem; min-width:0; padding:0 4px;"
                                                       OnClick="@(() => ShowDiff(fp))">
                                                @relPath
                                            </MudButton>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body2" Style="flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                                @relPath
                                            </MudText>
                                        }
                                    </MudStack>

                                    @if (state == ConflictFileState.Unresolved)
                                    {
                                        @if (_treeConflictPaths.Contains(fp))
                                        {
                                            @* Tree conflict — only "mark resolved" is valid for SVN *@
                                            <MudStack Row="true" Spacing="1" Class="ml-5" AlignItems="AlignItems.Center">
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">Directory conflict — verify the contents are correct, then:</MudText>
                                                <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                                           Color="Color.Success"
                                                           Disabled="_isWorking"
                                                           OnClick="@(() => ResolveFile(fp, ConflictResolutionChoice.MarkResolved))">
                                                    Mark as Resolved
                                                </MudButton>
                                            </MudStack>
                                        }
                                        else
                                        {
                                            @* Text conflict — full resolution options *@
                                            <MudStack Row="true" Spacing="1" Class="ml-5">
                                                <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                                           Color="Color.Primary"
                                                           Disabled="_isWorking"
                                                           OnClick="@(() => ResolveFile(fp, ConflictResolutionChoice.AcceptIncoming))">
                                                    Accept Incoming
                                                </MudButton>
                                                <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                                           Disabled="_isWorking"
                                                           OnClick="@(() => ResolveFile(fp, ConflictResolutionChoice.KeepMine))">
                                                    Keep Mine
                                                </MudButton>
                                                <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                                           Color="Color.Secondary"
                                                           Disabled="_isWorking"
                                                           OnClick="@(() => SetEditingExternally(fp))">
                                                    Edit Externally
                                                </MudButton>
                                            </MudStack>
                                        }
                                    }
                                    else if (state == ConflictFileState.EditingExternally)
                                    {
                                        <MudStack Spacing="1" Class="ml-5">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Style="word-break:break-all;">
                                                @fp
                                            </MudText>
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                                       Color="Color.Success"
                                                       Disabled="_isWorking"
                                                       OnClick="@(() => ResolveFile(fp, ConflictResolutionChoice.MarkResolved))">
                                                Mark as Resolved
                                            </MudButton>
                                        </MudStack>
                                    }
                                </MudStack>
                            </MudListItem>

                            @if (filePath != _conflictStates.Keys.Last())
                            {
                                <MudDivider />
                            }
                        }
                    </MudList>
                </MudPaper>
            }

            @* ── Error message ── *@
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_errorMessage</MudAlert>
            }

        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_phase == MergePhase.Merging || _isWorking">
            Cancel
        </MudButton>

        @if (_phase == MergePhase.DirtyWorkingCopy)
        {
            <MudButton Color="Color.Default" Variant="Variant.Outlined"
                       Disabled="_isWorking"
                       OnClick="CommitFirst">
                @if (_isWorking) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> }
                Commit Changes
            </MudButton>
            <MudButton Color="Color.Warning" Variant="Variant.Filled"
                       Disabled="_isWorking"
                       OnClick="RevertAll">
                @if (_isWorking) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> }
                Revert All
            </MudButton>
        }

        @if (_phase == MergePhase.ReadyToMerge)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                       Disabled="string.IsNullOrEmpty(_selectedBranch)"
                       OnClick="StartMerge">
                Merge
            </MudButton>
        }

        @if (_phase == MergePhase.ConflictResolution)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                       Disabled="_isWorking || !AllResolved"
                       OnClick="CommitMerge">
                Commit Merge
            </MudButton>
        }
    </DialogActions>
</MudDialog>
