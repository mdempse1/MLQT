<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MLQT.Cli</RootNamespace>
    <AssemblyName>mlqt</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Installable as a global/local dotnet tool: `dotnet tool install -g MLQT.Cli` → `mlqt`. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mlqt</ToolCommandName>
    <PackageId>MLQT.Cli</PackageId>
    <Version>0.1.0</Version>
    <Description>Headless CLI for MLQT: style-check a Modelica library and report findings.</Description>
    <PackageProjectUrl>https://github.com/mdempse1/MLQT</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mdempse1/MLQT</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- Read back by ToolInfo, so the package and the SARIF documents the tool writes cannot end up
         naming different places. -->
    <AssemblyMetadata Include="ProjectUrl" Value="$(PackageProjectUrl)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MLQT.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MLQT.Services\MLQT.Services.csproj" />
    <ProjectReference Include="..\ModelicaGraph\ModelicaGraph.csproj" />
    <ProjectReference Include="..\ModelicaParser\ModelicaParser.csproj" />
  </ItemGroup>

</Project>
