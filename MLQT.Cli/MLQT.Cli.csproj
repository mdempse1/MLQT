<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Server GC (B281). A check parses tens of thousands of classes from every core at once, and
         parsing allocates heavily: under the default workstation GC every thread stops for every
         collection on one shared heap, and the whole-graph analyses spent 53 of their 72 seconds on
         Claytex suspended waiting for it. Measured over the Claytex repository with the Dymola 2026x
         library folder: 242s -> 104s on the same code, 70.5s with B281's parallel analyzers, peak
         memory 8.2 GB -> 8.7 GB, findings identical. Every host sets this; HostGarbageCollectionTests
         holds that, because the parallel analyzers are slower than serial ones without it. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MLQT.Cli</RootNamespace>
    <AssemblyName>mlqt</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Installable as a global/local dotnet tool: `dotnet tool install -g MLQT.Cli` → `mlqt`. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mlqt</ToolCommandName>
    <PackageId>MLQT.Cli</PackageId>
    <Description>Headless CLI for MLQT: style-check a Modelica library and report findings.</Description>
    <PackageProjectUrl>https://github.com/mdempse1/MLQT</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mdempse1/MLQT</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- Read back by ToolInfo, so the package and the SARIF documents the tool writes cannot end up
         naming different places. -->
    <AssemblyMetadata Include="ProjectUrl" Value="$(PackageProjectUrl)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MLQT.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MLQT.Services\MLQT.Services.csproj" />
    <ProjectReference Include="..\ModelicaGraph\ModelicaGraph.csproj" />
    <ProjectReference Include="..\ModelicaParser\ModelicaParser.csproj" />
  </ItemGroup>

</Project>
