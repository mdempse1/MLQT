<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MLQT.McpServer</RootNamespace>
    <AssemblyName>MLQT.McpServer</AssemblyName>
    <!-- Serialize using reflection-based metadata; the MCP SDK reads tool schemas via reflection. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
    <!-- Generic host (Host.CreateApplicationBuilder). This was previously provided by the
         Microsoft.AspNetCore.App framework reference, which is no longer needed now that
         MLQT.Services is UI-free (no MudBlazor). -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MLQT.McpServer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MLQT.Services\MLQT.Services.csproj" />
    <ProjectReference Include="..\ModelicaGraph\ModelicaGraph.csproj" />
    <ProjectReference Include="..\ModelicaParser\ModelicaParser.csproj" />
    <ProjectReference Include="..\RevisionControl\RevisionControl.csproj" />
  </ItemGroup>

</Project>
