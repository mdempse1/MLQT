<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MLQT.McpServer</RootNamespace>
    <AssemblyName>MLQT.McpServer</AssemblyName>
    <!-- Serialize using reflection-based metadata; the MCP SDK reads tool schemas via reflection. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- MLQT.Services (transitively) pulls in MudBlazor, whose component dependencies live in
         the ASP.NET Core shared framework. Reference it so those assemblies resolve at runtime. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MLQT.McpServer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MLQT.Services\MLQT.Services.csproj" />
    <ProjectReference Include="..\ModelicaGraph\ModelicaGraph.csproj" />
    <ProjectReference Include="..\ModelicaParser\ModelicaParser.csproj" />
    <ProjectReference Include="..\RevisionControl\RevisionControl.csproj" />
  </ItemGroup>

</Project>
