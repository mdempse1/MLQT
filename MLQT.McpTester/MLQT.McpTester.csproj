<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- Photino, not MAUI, and no -windows in the target framework: phase 7b-1. This app was a
             MAUI Blazor app targeting net10.0-windows, which meant the MAUI workload had to stay
             installed in CI for its sake alone, long after the main application stopped needing it.
             Porting it first is the rehearsal for MLQT itself - same host model, same bootstrap, no
             users to disappoint - and it gains Linux on the way, which is useful for a tool whose
             whole job is talking to MCP servers. -->
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>WinExe</OutputType>
        <RootNamespace>MLQT.McpTester</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Photino.Blazor" Version="4.0.13" />
        <!-- Pinned forward so the whole graph sits on the 10.0.x line rather than the 9.0.1 that
             Photino's net9.0 asset group brings in. 7b-0 confirmed both work; this is tidiness. -->
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
        <PackageReference Include="MudBlazor" Version="9.6.0" />
        <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
    </ItemGroup>

</Project>
