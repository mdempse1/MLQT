@inherits LayoutComponentBase
@using MLQT.UI.Theme

@* MLQT's theme, built once: the tester has no settings to choose a palette from. *@
<MudThemeProvider Theme="@_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIcon Icon="@Icons.Material.Filled.Hub" Class="mr-2" />
        <MudText Typo="Typo.h6">MCP Server Tester</MudText>
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private static readonly MudTheme _theme = MlqtTheme.BuildTheme(MlqtTheme.GetDefaultPaletteLight());
}
