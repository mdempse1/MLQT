<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="NetMQ" Version="4.0.4.2" />
    <!-- Pin a patched System.Security.Cryptography.Xml; NetMQ (and NetMQ -> System.ServiceModel.Primitives)
         pull a vulnerable version transitively. 10.0.9 fixed the earlier ServiceModel advisories
         (GHSA-37gx-xxp4-5rgx, GHSA-w3x6-4m5h-cxqf) but is itself affected by CVE-2026-50648
         (EncryptedXml denial of service), patched in 10.0.10. This pin is the single upstream source,
         so the fix cascades to every downstream project (MLQT.Services, McpServer, Cli, MAUI app). -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenModelicaInterface.Tests" />
  </ItemGroup>

</Project>
