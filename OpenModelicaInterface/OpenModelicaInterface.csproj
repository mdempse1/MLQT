<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TrackPublicApi>true</TrackPublicApi>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="NetMQ" Version="4.0.4.2" />
    <!-- Pin a patched System.Security.Cryptography.Xml; NetMQ (and NetMQ -> System.ServiceModel.Primitives)
         pull a vulnerable version transitively. 10.0.13 is the first release fixing the denial-of-service
         advisories GHSA-r955-8q5j-3h83, GHSA-7hqp-7c5m-4vq6 and GHSA-c399-9853-6jmj, and it requires
         System.Security.Cryptography.Pkcs 10.0.13, which fixes GHSA-846f-f764-76mx and
         GHSA-2fmv-rv2c-59x7 - so Pkcs needs no pin of its own. This pin is the single upstream source,
         so the fix cascades to every downstream project (MLQT.Services, McpServer, Cli, Photino), and to
         any project outside this repository that builds them from source. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenModelicaInterface.Tests" />
  </ItemGroup>

</Project>
