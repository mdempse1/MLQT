<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- No -windows in the target framework: this is the host that gives MLQT a Linux UI, which is
         phase 7's whole deliverable. Phase 7b-2. -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>MLQT.Photino</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MLQT.Photino</AssemblyName>
    <!-- The icon on the executable itself, which is what Explorer and the Alt-Tab list use. The
         window's own icon is set at runtime; see Program.ApplicationIcon. -->
    <ApplicationIcon>..\Branding\mlqt.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Beside the executable, because Photino's SetIconFile takes a path rather than a resource.
         Both formats ship: Windows needs the multi-size .ico, GTK needs a PNG. -->
    <None Include="..\Branding\mlqt.ico" Link="mlqt.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Branding\mlqt-256.png" Link="mlqt-256.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Photino.Blazor" Version="4.0.13" />
    <!-- Pinned forward so the graph sits on the 10.0.x line MLQT.Shared uses rather than the 9.0.1
         Photino's net9.0 asset group brings in. 7b-0 confirmed both work; this is tidiness. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MLQT.Shared/MLQT.Shared.csproj" />
  </ItemGroup>

  <!--
    Bundle the SlikSVN command-line client into the app output under "svn/", so SVN works on a
    machine that has no svn of its own (see RevisionControl/SvnToolLocator.cs, which prefers this
    copy and falls back to PATH). The binaries are populated by build/fetch-svn-tools.ps1 and are
    not committed, so an empty folder matches nothing and the app falls back — which is exactly how
    this went missing: the host was ported without the payload, every developer had svn on PATH, and
    the self-test's svn probe passed on all of them (7b-7).

    Windows only. On Linux the .deb declares `subversion` as a dependency and the locator finds it
    on PATH, which is what a Linux user expects and avoids shipping someone else's binaries.
  -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT' or $([MSBuild]::IsOSPlatform('Windows'))">
    <None Include="..\svn-tools\win-x64\**\*"
          Link="svn\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
