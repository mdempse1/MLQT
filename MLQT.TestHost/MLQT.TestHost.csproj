<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Not a product: it exists so the journeys can drive MLQT's UI without a desktop host. -->
    <RootNamespace>MLQT.TestHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MLQT.Shared\MLQT.Shared.csproj" />
  </ItemGroup>

  <!-- The one settings double, linked rather than copied, so what every journey runs on is the
       implementation SettingsServiceContract holds (B365). -->
  <ItemGroup>
    <Compile Include="../TestSupport/InMemorySettingsService.cs" Link="TestSupport/InMemorySettingsService.cs" />
  </ItemGroup>

</Project>
